{#let d = data.i18n[lang] ?? data.i18n.en}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#FFFDFB">
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#201B18">
<title>{#if title && layout != 'home'}{title} &sdot; {/if}{site.title}</title>
<meta name="description" content="{description ?? d.meta.description}" />
<meta name="author" content="{site.author}" />
<meta property="og:type" content="{layout == 'post' ? 'article' : 'website'}" />
<meta property="og:title" content="{layout == 'home' ? site.title : (title ?? site.title)}" />
<meta property="og:description" content="{description ?? d.meta.description}" />
<meta property="og:site_name" content="{site.title}" />
<meta name="twitter:card" content="summary" />
<link rel="icon" type="image/png" href="/assets/favicon.png" />
{#if layout == 'home' || layout == 'blog' || layout == 'support'}
{#let path = layout == 'home' ? '' : layout == 'blog' ? 'blog/' : 'support/'}
<link rel="alternate" hreflang="en" href="{site.custom.siteUrl}/{path}" />
<link rel="alternate" hreflang="es" href="{site.custom.siteUrl}/es/{path}" />
<link rel="alternate" hreflang="it" href="{site.custom.siteUrl}/it/{path}" />
<link rel="alternate" hreflang="x-default" href="{site.custom.siteUrl}/{path}" />
{/if}
<link rel="alternate" type="application/rss+xml" title="{site.title}" href="/feed.xml" />
<link rel="alternate" type="application/atom+xml" title="{site.title}" href="/atom.xml" />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="/assets/css/index.css" />
<script src="/assets/js/theme-init.js"></script>
<script type="module" src="https://unpkg.com/ionicons@5.2.3/dist/ionicons/ionicons.esm.js"></script>
<script nomodule src="https://unpkg.com/ionicons@5.2.3/dist/ionicons/ionicons.js"></script>
