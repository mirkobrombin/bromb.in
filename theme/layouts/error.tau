<!doctype html>
<html lang="{lang}">
<head>
{@include "Head"}
</head>
<body>
{@include "Nav"}
<main>
<div class="wrapper">

<section class="hero">
  <span class="eyebrow">~/404</span>
  <h1 class="display" style="margin-block: 1rem .75rem;">{ '404.title' | t(lang) }</h1>
  <p class="lead">{ '404.description' | t(lang) }</p>
  <div class="hero-actions">
    <a class="button primary" href="/">
      <ion-icon name="arrow-back-outline"></ion-icon> { 'nav.me' | t(lang) }
    </a>
  </div>
  <div class="prose" style="margin-top: 2rem;">{@html content}</div>
</section>

</div>
</main>
{@include "Footer"}
</body>
</html>
