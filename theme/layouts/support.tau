{#let d = data.i18n[lang] ?? data.i18n.en}
<!doctype html>
<html lang="{lang}">
<head>
{@include "Head"}
</head>
<body>
{@include "Nav"}
<main>
<div class="wrapper">

<section class="hero" style="padding-bottom: 1.5rem;">
  <span class="eyebrow">{d.support.label}</span>
  <h1 class="display" style="margin-block: 1rem .75rem;">{d.support.title}</h1>
  <p class="lead" style="max-width: 54ch;">{d.support.intro}</p>
</section>

<section class="section" style="padding-top: 1.5rem;">
  <div class="section-head">
    <div>
      <span class="eyebrow">{d.support.direct_label}</span>
      <h2>{d.support.direct_title}</h2>
    </div>
  </div>

  <div class="support-grid">
    <div class="support-card is-highlight">
      <div class="support-top">
        <div>
          <ion-icon name="logo-github"></ion-icon>
          <h3>{d.support.github}</h3>
        </div>
        <span class="support-tag">{d.support.recommended}</span>
      </div>
      <p>{d.support.github_desc}</p>
      <a href="https://github.com/sponsors/mirkobrombin" class="button primary">
        {d.support.github_sponsor} <ion-icon name="arrow-forward-outline"></ion-icon>
      </a>
    </div>

    <div class="support-card">
      <div class="support-top">
        <div>
          <ion-icon name="logo-paypal"></ion-icon>
          <h3>{d.support.paypal}</h3>
        </div>
        <span class="support-tag">{d.support.paypal_tag}</span>
      </div>
      <p>{d.support.paypal_desc}</p>
      <a href="https://www.paypal.com/donate?hosted_button_id=HM2VKUH5STU4J" class="button secondary">
        {d.support.paypal_donate}
      </a>
      <a href="https://paypal.me/MirkoBrombin" class="button link">{d.support.paypal_old}</a>
    </div>

    <div class="support-card">
      <div class="support-top">
        <div>
          <ion-icon name="heart-outline"></ion-icon>
          <h3>{d.support.patreon}</h3>
        </div>
        <span class="support-tag">{d.support.patreon_tag}</span>
      </div>
      <p>{d.support.patreon_desc}</p>
      <a href="https://www.patreon.com/MirkoBrombin" class="button secondary">
        {d.support.patreon_support}
      </a>
    </div>

    <div class="support-card">
      <div class="support-top">
        <div>
          <ion-icon name="card-outline"></ion-icon>
          <h3>{d.support.bank}</h3>
        </div>
        <span class="support-tag">{d.support.bank_tag}</span>
      </div>
      <p>{d.support.bank_desc}</p>
      <div class="copy-field">
        <div class="copy-body">
          <span class="copy-label">IBAN</span>
          <span class="copy-value">LT50 3250 0948 5804 5072</span>
        </div>
        <button class="copy-button" data-copy="LT503250094858045072" aria-label="{d.support.copy}">
          <ion-icon name="copy-outline"></ion-icon>
        </button>
      </div>
      <div class="copy-field">
        <div class="copy-body">
          <span class="copy-label">BIC / SWIFT</span>
          <span class="copy-value">REVOLT21</span>
        </div>
        <button class="copy-button" data-copy="REVOLT21" aria-label="{d.support.copy}">
          <ion-icon name="copy-outline"></ion-icon>
        </button>
      </div>
      <p class="note">{d.support.bank_holder} Mirko Brombin</p>
    </div>

    <div class="support-card is-wide">
      <div class="support-top">
        <div>
          <ion-icon name="logo-bitcoin"></ion-icon>
          <h3>{d.support.crypto}</h3>
        </div>
        <span class="support-tag">{d.support.crypto_tag}</span>
      </div>
      <div class="fund-list" style="grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: .5rem;">
        <div>
          <div class="copy-field">
            <div class="copy-body">
              <span class="copy-label">Bitcoin &middot; BTC (SegWit)</span>
              <span class="copy-value">bc1qaujs7f50uutxrr9nh92hr3n7nkl76lltncgdmj</span>
            </div>
            <button class="copy-button" data-copy="bc1qaujs7f50uutxrr9nh92hr3n7nkl76lltncgdmj" aria-label="{d.support.copy}">
              <ion-icon name="copy-outline"></ion-icon>
            </button>
          </div>
          <div class="copy-field">
            <div class="copy-body">
              <span class="copy-label">Ethereum &middot; ERC20</span>
              <span class="copy-value">0x20D27496EC8e1d85c0b5A0bF8fbAE8cBd826F9e6</span>
            </div>
            <button class="copy-button" data-copy="0x20D27496EC8e1d85c0b5A0bF8fbAE8cBd826F9e6" aria-label="{d.support.copy}">
              <ion-icon name="copy-outline"></ion-icon>
            </button>
          </div>
        </div>
        <div>
          <div class="copy-field">
            <div class="copy-body">
              <span class="copy-label">Litecoin &middot; LTC</span>
              <span class="copy-value">ltc1qy8tz3gd52j68lzuy3nlr72ngt3wv09ffsf3q2l</span>
            </div>
            <button class="copy-button" data-copy="ltc1qy8tz3gd52j68lzuy3nlr72ngt3wv09ffsf3q2l" aria-label="{d.support.copy}">
              <ion-icon name="copy-outline"></ion-icon>
            </button>
          </div>
          <div class="copy-field">
            <div class="copy-body">
              <span class="copy-label">Ripple &middot; XRP</span>
              <span class="copy-value">rLNmmcNEizWaygypRVTKaWoZG6RrqfsJpi</span>
            </div>
            <button class="copy-button" data-copy="rLNmmcNEizWaygypRVTKaWoZG6RrqfsJpi" aria-label="{d.support.copy}">
              <ion-icon name="copy-outline"></ion-icon>
            </button>
          </div>
        </div>
      </div>
      <p class="note">{d.support.xrp_memo}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{d.support.projects_label}</span>
      <h2>{d.support.support_projects}</h2>
      <p>{d.support.projects_desc}</p>
    </div>
    <a class="button secondary" href="https://github.com/mirkobrombin">
      <ion-icon name="logo-github"></ion-icon> {d.support.all_projects}
    </a>
  </div>

  <div class="fund-list">
    <a class="fund-item" href="https://usebottles.com/funding/">
      <img src="https://usebottles.com/uploads/bottles.png" alt="Bottles" loading="lazy">
      <div>
        <h4>Bottles</h4>
        <p>{d.projects.bottles_desc}</p>
      </div>
      <ion-icon name="arrow-forward-outline"></ion-icon>
    </a>
    <a class="fund-item" href="https://vanillaos.org/get-involved/funding">
      <img src="https://vanillaos.org/assets/images/brand/vanillaos-logo-icon.svg" alt="Vanilla OS" loading="lazy">
      <div>
        <h4>Vanilla OS</h4>
        <p>{d.projects.vanilla_desc}</p>
      </div>
      <ion-icon name="arrow-forward-outline"></ion-icon>
    </a>
    <a class="fund-item" href="https://github.com/sponsors/tryGoUp">
      <img src="https://avatars.githubusercontent.com/u/197488840?s=200&v=4" alt="GoUp!" loading="lazy">
      <div>
        <h4>GoUp!</h4>
        <p>{d.projects.goup_desc}</p>
      </div>
      <ion-icon name="arrow-forward-outline"></ion-icon>
    </a>
    <a class="fund-item" href="https://github.com/sponsors/Containerpak">
      <img src="https://avatars.githubusercontent.com/u/144563190?s=200&v=4" alt="Containerpak" loading="lazy">
      <div>
        <h4>Containerpak</h4>
        <p>{d.projects.containerpak_desc}</p>
      </div>
      <ion-icon name="arrow-forward-outline"></ion-icon>
    </a>
  </div>
</section>

</div>
</main>
{@include "Footer"}
</body>
</html>
