{#let items = lang == 'en' ? collections.blog.items : collections[lang == 'es' ? 'blog-es' : 'blog-it'].items}
<!doctype html>
<html lang="{lang}">
<head>
{@include "Head"}
</head>
<body>
{@include "Nav"}
<main>
<div class="wrapper">

<section class="hero" style="padding-bottom: 1.5rem;">
  <span class="eyebrow">{ 'blog.label' | t(lang) }</span>
  <h1 class="display" style="margin-block: 1rem .75rem;">{ 'blog.title' | t(lang) }</h1>
  <p class="lead">{ 'blog.description' | t(lang) }</p>
  <p class="mono" style="margin-top: 1.25rem; color: var(--fg-subtle);">
    {items.length} { 'blog.count' | t(lang) }
  </p>
</section>

<section class="section" style="padding-top: 1rem;">
  <div class="post-list">
    {#each items as item}
      <PostCard post={item.frontmatter} url={item.url} />
    {:else}
      <p>{ 'blog.count' | t(lang) }</p>
    {/each}
  </div>
</section>

</div>
</main>
{@include "Footer"}
</body>
</html>
