{#let d = data.i18n[lang] ?? data.i18n.en}
{#let items = lang == 'en' ? collections.blog.items : collections[lang == 'es' ? 'blog-es' : 'blog-it'].items}
<!doctype html>
<html lang="{lang}">
<head>
{@include "Head"}
</head>
<body>
{@include "Nav"}
<main>
<div class="wrapper">

<section class="hero" style="padding-bottom: 1.5rem;">
  <span class="eyebrow">{d.blog.label}</span>
  <h1 class="display" style="margin-block: 1rem .75rem;">{d.blog.title}</h1>
  <p class="lead">{d.blog.description}</p>
  <p class="mono" style="margin-top: 1.25rem; color: var(--fg-subtle);">
    {items.length} {d.blog.count}
  </p>
</section>

<section class="section" style="padding-top: 1rem;">
  <div class="post-list">
    {#each items as item}
      <PostCard post={item.frontmatter} url={item.url} />
    {:else}
      <p>{d.blog.count}</p>
    {/each}
  </div>
</section>

</div>
</main>
{@include "Footer"}
</body>
</html>
