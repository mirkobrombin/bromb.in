{#let blogUrl = lang == 'en' ? '/blog/' : '/' + lang + '/blog/'}
<!doctype html>
<html lang="{lang}">
<head>
{@include "Head"}
</head>
<body>
{@include "Nav"}
<main>
<div class="wrapper">

<div class="progress-bar" id="progress-bar"></div>

<article>
  <header class="article-head">
    <a class="button link" href="{blogUrl}">
      <ion-icon name="arrow-back-outline"></ion-icon> { 'posts.back' | t(lang) }
    </a>
    <h1>{title}</h1>
    {#if description}<p class="lead" style="max-width: 60ch;">{description}</p>{/if}
    <div class="article-meta" style="margin-top: 1.5rem;">
      <time datetime="{date}">{date | date}</time>
      <span class="sep"></span>
      <span data-reading-time>{ 'posts.reading_time' | t(lang) }</span>
      {#if review_by}
      <span class="sep"></span>
      <span>{ 'posts.reviewed_by' | t(lang) } <a href="https://github.com/{review_by}">{review_by}</a></span>
      {/if}
    </div>
  </header>

  <div class="prose">
    {@html content}
  </div>

  <footer class="article-footer">
    <a class="button secondary" href="{blogUrl}">
      <ion-icon name="arrow-back-outline"></ion-icon> { 'posts.all' | t(lang) }
    </a>
    <span class="mono">{ 'posts.written_by' | t(lang) } <span class="signature">Mirko Brombin</span></span>
    <p class="note">{ 'posts.copyright' | t(lang) }</p>
  </footer>
</article>

</div>
</main>
{@include "Footer"}
</body>
</html>
