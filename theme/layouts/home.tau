{#let blogUrl = lang == 'en' ? '/blog/' : '/' + lang + '/blog/'}
{#let supportUrl = lang == 'en' ? '/support/' : '/' + lang + '/support/'}
{#let latest = lang == 'en' ? collections.blog.items : collections[lang == 'es' ? 'blog-es' : 'blog-it'].items}
<!doctype html>
<html lang="{lang}">
<head>
{@include "Head"}
</head>
<body>
{@include "Nav"}
<main>
<div class="wrapper">

<section class="hero">
  <span class="eyebrow">{ 'home.role' | t(lang) }</span>
  <h1 class="display">{ 'home.title' | t(lang) }</h1>
  <p class="lead">{ 'home.lead' | t(lang) }</p>
  <div class="hero-actions">
    <a class="button primary" href="{blogUrl}">
      { 'home.cta_read' | t(lang) } <ion-icon name="arrow-forward-outline"></ion-icon>
    </a>
    <a class="button secondary" href="https://github.com/mirkobrombin">
      <ion-icon name="logo-github"></ion-icon> GitHub
    </a>
    <a class="button ghost" href="{supportUrl}">{ 'nav.support' | t(lang) }</a>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{ 'home.story_label' | t(lang) }</span>
      <h2>{ 'home.story_title' | t(lang) }</h2>
    </div>
  </div>

  <div class="bio">
    <div class="reveal">
      <p>{ 'home.p1' | t(lang) }</p>
      <p>{ 'home.p2' | t(lang) }</p>
      <p>{ 'home.p3' | t(lang) }</p>
      <p>{ 'home.p4' | t(lang) }</p>
      <p>{ 'home.p5' | t(lang) }</p>
      <p>{ 'home.p6' | t(lang) }</p>
      <p>{ 'home.p7' | t(lang) }</p>
      <p>{ 'home.p8' | t(lang) }</p>
    </div>
    <button class="button secondary reveal-toggle" data-less="{ 'home.collapse' | t(lang) }">
      { 'home.expand' | t(lang) } <ion-icon name="chevron-down-outline"></ion-icon>
    </button>
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{ 'home.writing_label' | t(lang) }</span>
      <h2>{ 'home.writing_title' | t(lang) }</h2>
      <p>{ 'home.writing_desc' | t(lang) }</p>
    </div>
    <a class="button secondary" href="{blogUrl}">
      { 'home.all_articles' | t(lang) } <ion-icon name="arrow-forward-outline"></ion-icon>
    </a>
  </div>

  <div class="post-list">
    {#each latest as item, index}
      {#if index < 4}<PostCard post={item.frontmatter} url={item.url} />{/if}
    {/each}
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{ 'home.work_label' | t(lang) }</span>
      <h2>{ 'home.work_title' | t(lang) }</h2>
      <p>{ 'home.work_desc' | t(lang) }</p>
    </div>
    <a class="button secondary" href="https://github.com/mirkobrombin">
      <ion-icon name="logo-github"></ion-icon> { 'home.all_projects' | t(lang) }
    </a>
  </div>

  <div class="project-grid">
    {#each data.projects.now as project}
    <a class="project-card {project.accent ? 'is-accent' : ''}" href="{project.url}">
      <div class="project-top">
        <h3>{project.name}</h3>
        <span class="project-kind">{project.kind}</span>
      </div>
      <p>{project.desc[lang] ?? project.desc.en}</p>
      <div class="project-meta">
        <span class="lang">{project.lang}</span>
      </div>
    </a>
    {/each}
  </div>
</section>

<section class="section">
  <div class="section-head">
    <div>
      <span class="eyebrow">{ 'home.archive_label' | t(lang) }</span>
      <h2>{ 'home.archive_title' | t(lang) }</h2>
      <p>{ 'home.archive_desc' | t(lang) }</p>
    </div>
  </div>

  <div class="project-grid">
    {#each data.projects.archive as project}
    <a class="project-card is-quiet" href="{project.url}">
      <div class="project-top">
        <h3>{project.name}</h3>
        <span class="project-kind">{project.kind}</span>
      </div>
      <p>{project.desc[lang] ?? project.desc.en}</p>
      <div class="project-meta">
        <span class="lang">{project.lang}</span>
      </div>
    </a>
    {/each}
  </div>
</section>

<section class="section">
  <div class="cta">
    <div>
      <h2>{ 'home.cta_title' | t(lang) }</h2>
      <p>{ 'home.cta_desc' | t(lang) }</p>
    </div>
    <a class="button primary" href="{supportUrl}">
      <ion-icon name="heart-outline"></ion-icon> { 'nav.support' | t(lang) }
    </a>
  </div>
</section>

</div>
</main>
{@include "Footer"}
</body>
</html>
