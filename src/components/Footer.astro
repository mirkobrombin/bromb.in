---
import {Icon} from "astro-icon/components";
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';

const external = [
  { title: 'Mastodon', href: 'https://mastodon.social/@mirkobrombin', icon: 'simple-icons:mastodon', bg: '#fdeedc', fg: '#b66d3a' },
  { title: 'Twitter', href: 'https://twitter.com/mirkobrombin', icon: 'simple-icons:twitter', bg: '#e8f2ff', fg: '#2b6cb0' },
  { title: 'GitHub', href: 'https://github.com/mirkobrombin', icon: 'simple-icons:github', bg: '#f5f5f5', fg: '#111827' },
  { title: 'Telegram', href: 'https://telegram.me/mirkobrombin', icon: 'simple-icons:telegram', bg: '#e6f7ff', fg: '#0077cc' },
  { title: 'LinkedIn', href: 'https://www.linkedin.com/in/mirkobrombin/', icon: 'simple-icons:linkedin', bg: '#eef6f3', fg: '#0a6640' }
];

// internal templates: keep label/bg/fg but compute localized hrefs and translated titles below
const internalTemplates = [
  { key: 'stories', titleKey: 'nav.stories', label: 'S', bg: '#fff2e8', fg: '#b25d2f' },
  { key: 'cinema', titleKey: 'nav.cinema', label: 'C', bg: '#f0f8ff', fg: '#2563eb' },
  { key: 'travel', titleKey: 'nav.travels', label: 'T', bg: '#fff7ed', fg: '#933d1a' },
  { key: 'books', titleKey: 'nav.books', label: 'B', bg: '#f7fafc', fg: '#0f172a' },
  { key: 'work', titleKey: 'nav.work', label: 'W', bg: '#fff5f7', fg: '#9f2f5b' }
];

const currentLang = Astro.currentLocale || 'en';
const t = useTranslations(currentLang as any);
const internal = internalTemplates.map(item => ({
  ...item,
  href: getRelativeLocaleUrl(currentLang, item.key === 'stories' ? 'stories' : item.key)
}));
---

<div class="w-[90vw] lg:w-[70vw] mx-auto pb-24 lg:max-w-305">
    <footer class="w-full bg-white dark:bg-zinc-900 border-t border-black/8 dark:border-white/10 to-[#3e342f]/10 backdrop-blur-sm">
        <div class="max-w-7xl mx-auto px-6 py-12 md:py-20">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-10">
                <div class="flex-1">
                    <h1 class="text-3xl md:text-5xl font-semibold font-sans text-[#3e342f] dark:text-white">bromb.in</h1>
                    <p class="mt-3 text-xl font-sans text-black/65 dark:text-white/70 max-w-lg">{t('home.description')}</p>

                    <div class="mt-6 flex items-center gap-4">
                        <a href="https://github.com/mirkobrombin/bromb.in"
                           class="inline-flex items-center justify-center gap-2 text font-sans text-xl font-medium text-[#3e342f] dark:text-white underline">
                            <Icon name="material-symbols:code" class="size-6"/>
                            {t('footer.source')}
                        </a>
                        <a href={getRelativeLocaleUrl(currentLang, 'privacy')}
                           class="text-xl font-sans inline-flex items-center justify-center gap-2 text-black/70 dark:text-white/70 underline">
                            <Icon name="material-symbols:privacy-tip-outline" class="size-6 inline-block"/>
                            {t('footer.privacy')}
                        </a>
                    </div>
                </div>

                <div class="flex-1 md:flex-[0.9] grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
                    <div class="bg-white/90 dark:bg-white/10 backdrop-blur rounded-xl p-4 md:p-6 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition">
                        <p class="text-xl font-sans font-semibold mb-3 dark:text-white">{t('footer.external')}</p>
                        <ul class="space-y-2">
                            {external.map(item => (
                                    <li>
                                        <a class="flex items-center gap-3 text-base hover:text-[#3e342f] dark:hover:text-white transition underline-offset-2 underline"
                                           href={item.href}>
                                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full"
                                              style={`background: ${item.bg}; color: ${item.fg}`}>
                                            <Icon name={item.icon} class="size-4"/>
                                        </span>
                                            {item.title}
                                        </a>
                                    </li>
                            ))}
                        </ul>
                    </div>

                    <div class="bg-white/90 dark:bg-white/10 backdrop-blur rounded-xl p-4 md:p-6 hover:bg-zinc-100 dark:hover:bg-zinc-900 transition">
                        <p class="text-xl font-sans font-semibold mb-3 dark:text-white">{t('footer.internal')}</p>
                        <ul class="space-y-2">
                            {internal.map(item => (
                                    <li>
                                        <a class="flex items-center gap-3 text-base hover:text-[#3e342f] dark:hover:text-white transition"
                                           href={item.href}>
                                        <span class="inline-flex items-center justify-center w-7 h-7 rounded-full"
                                              style={`background: ${item.bg}; color: ${item.fg}`}>
                                            {item.label}
                                        </span>
                                            <span class="underline underline-offset-2 dark:text-white"> {t(item.titleKey)}</span>
                                        </a>
                                    </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-8 border-t border-black/8 dark:border-white/10 pt-6 flex flex-col md:flex-row items-center justify-between gap-4">
                <p class="text-md font-sans text-black/60 dark:text-white/60">{t('footer.copyright')}</p>

                <div class="flex items-center gap-4">
                    <div class="flex flex-row items-center justify-center gap-2">
                        <p class="text-md font-sans text-black/60 dark:text-white/60">{t('footer.designedBy')}</p>
                        <p class="text-md font-sans font-semibold underline dark:text-white">Mirko Brombin</p>
                    </div>
                    <p class="text-md font-sans text-black/60 dark:text-white/60">•</p>

                    <div class="flex flex-row items-center justify-center gap-2">

                        <p class="text-md font-sans text-black/60 dark:text-white/60">{t('footer.developedBy')}</p>
                        <p class="text-md font-sans font-semibold underline dark:text-white">Gabriel Cozma</p>
                    </div>
                </div>
            </div>
        </div>
    </footer>
</div>