---
import {getRelativeLocaleUrl} from 'astro:i18n';
import {useTranslations} from '../i18n/utils';
import MobileHeader from './header/MobileHeader.astro';
import DesktopNav from './header/DesktopNav.astro';
import DesktopTitleBar from './header/DesktopTitleBar.astro';

const TEMPORARILY_DISABLED_NAV_KEYS = new Set([
    'travels',
    'food-drinks',
    'books',
    'work',
]);

const navItems = [
    { key: 'home', trans: 'home' },
    { key: 'stories', trans: 'stories' },
    { key: 'cinema', trans: 'cinema' },
    { key: 'travels', trans: 'travels' },
    { key: 'food-drinks', trans: 'foodanddrinks' },
    { key: 'books', trans: 'books' },
    { key: 'work', trans: 'work' },
].map((item) => ({
    ...item,
    disabled: TEMPORARILY_DISABLED_NAV_KEYS.has(item.key),
}));

const navGroups = [
    {items: [0], class: "flex flex-row gap-4 md:gap-8 justify-center items-center"}, // main
    {items: [1, 2, 3, 4], class: "hidden md:flex flex-row gap-4"}, // secondary
    {items: [5, 6], class: "hidden md:flex flex-row gap-4"}, // tertiary
];

export let currentPage = null;

// i18n bootstrap for this component
const currentLang = Astro.currentLocale || 'en';
const t = useTranslations(currentLang);
const aboutUrl = getRelativeLocaleUrl(currentLang, 'about');
---
<MobileHeader
    navItems={navItems}
    currentPage={currentPage}
    currentLang={currentLang}
    t={t}
    getRelativeLocaleUrl={getRelativeLocaleUrl}
    aboutUrl={aboutUrl}
/>

<div class="fixed w-full z-50">
    <DesktopNav
        navItems={navItems}
        navGroups={navGroups}
        currentLang={currentLang}
        t={t}
        getRelativeLocaleUrl={getRelativeLocaleUrl}
    />
</div>

<DesktopTitleBar currentLang={currentLang} t={t} aboutUrl={aboutUrl}/>

<style>
    #desktop-header {
        transition: none !important;
        background-color: transparent;
        backdrop-filter: none;
        box-shadow: none;
        top: 48px;
        color: inherit;
    }

    #desktop-header[data-search-active="true"] {
        min-width: min(640px, 70vw);
        width: min(70vw, 48rem);
        max-width: 48rem;
        border-radius: 9999px;
        padding: 0.5rem;
        gap: 0;
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: saturate(1.15) blur(10px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
    }

    #desktop-header[data-search-active="true"][data-search-has-results="true"] {
        border-radius: 1rem;
    }

    :global(html.dark) #desktop-header[data-search-active="true"] {
        background: rgba(24, 24, 27, 0.84);
    }

    #desktop-header[data-search-active="true"] :global(.search-input-row) {
        background: rgba(243, 244, 246, 0.95);
    }

    :global(html.dark) #desktop-header[data-search-active="true"] :global(.search-input-row) {
        background: rgba(63, 63, 70, 0.75);
    }

    #mobile-header,
    #desktop-title-bar {
        color: inherit;
        transition: color 200ms cubic-bezier(.2, .9, .3, 1);
    }

    .scroll-to-top-btn {
        transition: opacity 180ms linear, transform 180ms cubic-bezier(.2, .9, .3, 1);
        opacity: 0;
        pointer-events: none;
    }

    @media (min-width: 1024px) and (max-width: 1280px) {
        #desktop-title-bar {
            margin-top: 1.5rem;
        }

        #desktop-header {
            top: -0.5rem !important;
        }
    }
</style>

<script>
    import { initHeaderClient } from '../../scripts/header/init.ts';

    initHeaderClient();
</script>
