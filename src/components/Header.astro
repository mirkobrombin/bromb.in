---
import {Icon} from "astro-icon/components";

const navItems = [
    {name: "HOME", href: "/", key: "home"},
    {name: "STORIES", href: "/stories", key: "stories"},
    {name: "CINEMA", href: "/cinema", key: "cinema"},
    {name: "TRAVELS", href: "/travels", key: "travels"},
    {name: "FOOD & DRINKS", href: "/food-drinks", key: "food-drinks"},
    {name: "BOOKS", href: "/books", key: "books"},
    {name: "WORK", href: "/work", key: "work"},
];

const navGroups = [
    {items: [0], class: "flex flex-row gap-4 md:gap-8 justify-center items-center"}, // main
    {items: [1, 2, 3, 4], class: "hidden md:flex flex-row gap-4"}, // secondary
    {items: [5, 6], class: "hidden md:flex flex-row gap-4"}, // tertiary
];

const footerLinks = [
    {name: "ABOUT", href: "/about"},
];

export let currentPage = null;
---

<div class="flex items-center justify-between px-4 h-18 md:h-16 lg:hidden" id="mobile-header">
    <h1 class="text-3xl font-semibold font-sans">bromb.in</h1>
    <button id="hamburger-menu" class="material-symbols-outlined text-4xl"
            onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">menu
    </button>
</div>

<div class="fixed w-full z-50">
    <div id="mobile-menu"
         class="hidden font-sans fixed top-0 left-0 w-full h-full bg-primary/80 backdrop-blur-md flex flex-col items-center justify-center text-black transition-all duration-300 opacity-0 transform scale-95">
        <button class="absolute top-5 right-4 material-symbols-outlined text-3xl"
                onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">close
        </button>

        <nav class="flex flex-col gap-4 text-lg font-medium font-sans">
            {navItems.map(item => (
                    <a href={item.href} data-key={item.key}
                       class={`hover:underline ${currentPage === item.key ? "font-extrabold" : ""}`}>{item.name}</a>
            ))}
        </nav>

        <div class="flex flex-col items-center gap-4 mt-8">
            <div class="flex gap-2 justify-center md:justify-start">
                {footerLinks.map(item => <a href={item.href} class="hover:underline">{item.name}</a>)}
            </div>
        </div>
    </div>

    <!-- Desktop header -->
    <nav id="desktop-header"
         class="absolute left-1/2 transform -translate-x-1/2 top-12 hidden lg:flex flex-row gap-4 items-center justify-between font-sans text-md px-4 py-2 md:gap-12 md:px-8 rounded-full w-max">
        <div id="desktop-nav-groups" class="flex items-center gap-8">
            {navGroups.map(group => (
                    <div class={group.class}>
                        {group.items.map(i => (
                                <a href={navItems[i].href} data-key={navItems[i].key}
                                   class="hover:underline opacity-80">{navItems[i].name}</a>
                        ))}
                    </div>
            ))}

            <div class="hidden md:flex flex-row gap-4" id="desktop-nav-icons">
                <button id="search-button" class="hover:underline flex items-center justify-center"
                        onclick="toggleInlineSearch()" type="button">
                    <span class="material-symbols-outlined text-xl">search</span>
                </button>
            </div>
        </div>

        <div id="desktop-inline-search" class="hidden w-full flex flex-col">
            <div class="flex items-center gap-3 relative">
                <button class="flex items-center justify-between hover:bg-gray-200 dark:hover:bg-zinc-800 rounded-full"
                        aria-label="Close inline search" onclick="closeInlineSearch()" type="button">
                    <Icon name="material-symbols:search" class="size-5"/>
                </button>
                <input id="search-input-inline"
                       class="w-140 h-7 bg-transparent outline-none text-sm md:text-lg text-center font-semibold"
                       placeholder="What are you looking for?" aria-label="Search"/>
                <div id="search-count-inline" class="text-sm text-gray-500 hidden">0 Results</div>
            </div>
            <div id="search-results-inline" class="max-h-64 overflow-auto space-y-2" role="listbox" tabindex="-1"></div>
        </div>
    </nav>
</div>

<div id="desktop-title-bar"
     class="hidden lg:flex flex-col md:flex-row justify-between items-center md:items-center pb-2 font-sans w-[90vw] lg:w-[70vw] mx-auto lg:max-w-305 py-12">
    <h1 class="text-4xl md:text-5xl font-semibold text-center md:text-left">bromb.in</h1>
    <div class="flex flex-col md:flex-row gap-2 mt-4 md:mt-0">
        <div class="flex gap-2 justify-center md:justify-start">
            {footerLinks.map(item => <a href={item.href} class="hover:underline opacity-80">{item.name}</a>)}
        </div>
    </div>
</div>

<style>
    #desktop-header {
        transition: none !important;
        will-change: top, background-color, backdrop-filter, box-shadow, border-radius, color;
        background-color: transparent;
        backdrop-filter: none;
        box-shadow: none;
        top: 48px;

        color: var(--nav-text, var(--header-text, inherit));
    }

    #mobile-header,
    #desktop-title-bar {
        color: var(--header-text, inherit);
        transition: color 200ms cubic-bezier(.2, .9, .3, 1);
        will-change: color;
    }

    .scroll-to-top-btn {
        transition: opacity 180ms linear, transform 180ms cubic-bezier(.2, .9, .3, 1);
        opacity: 0;
        pointer-events: none;
    }
</style>

<script>
    import Fuse, {type Expression} from "fuse.js";

    let headerTextColor: string | null = null;
    let searchIndex = [];
    let fuse: string | Fuse<unknown> | null = null;
    let searchLoaded = false;
    let selectedIndex = -1;
    let currentResults: string | any[] = [];

    const q = (s: string) => document.querySelector(s);
    const id = (i: string) => document.getElementById(i);

    function parseColor(input = "") {
        if (!input) return null;
        const s = String(input).trim();
        const hex = s.replace('#', '');
        if (/^[0-9a-fA-F]{3}$/.test(hex) || /^[0-9a-fA-F]{6}$/.test(hex)) {
            const h = hex.length === 3 ? hex.split('').map(c => c + c).join('') : hex;
            return [parseInt(h.slice(0, 2), 16), parseInt(h.slice(2, 4), 16), parseInt(h.slice(4, 6), 16)];
        }
        const m = s.match(/rgba?\s*\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/i);
        if (m) return [parseInt(m[1], 10), parseInt(m[2], 10), parseInt(m[3], 10)];
        return null;
    }

    function findThemeCandidate() {
        const root = q(".fixed.w-full.z-50");
        if (!root) return null;
        let cand = root.parentElement?.nextElementSibling;
        while (cand && !cand.hasAttribute?.("data-theme") && !cand.hasAttribute?.("data-theme-color")) cand = cand.nextElementSibling;
        if (!cand) {
            cand = Array.from(document.querySelectorAll("[data-theme], [data-theme-color]"))
                .find(el => root.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING);
        }
        return cand || null;
    }

    function getThemeRgb() {
        const candidate = findThemeCandidate();
        if (!candidate) return null;
        const dt = (candidate as HTMLElement)?.dataset?.themeColor;
        const inlineBg = (candidate as HTMLElement)?.style?.backgroundColor || "";
        const computedBg = getComputedStyle(candidate).backgroundColor || "";

        return parseColor(dt) || parseColor(inlineBg) || parseColor(computedBg) || null;
    }

    function contrastForRgb(rgb: number[]) {
        if (!rgb) return null;
        const [r, g, b] = rgb.map(v => v / 255);
        const srgb = [r, g, b].map(c => (c <= 0.03928) ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));
        const lum = 0.2126 * srgb[0] + 0.7152 * srgb[1] + 0.0722 * srgb[2];
        return lum > 0.179 ? "#000" : "#fff";
    }

    function setHeaderTextColor() {
        const headerRoot = q(".fixed.w-full.z-50");
        if (!headerRoot) return;
        const searchActive = (headerRoot as HTMLElement)?.dataset?.searchActive === "true";
        const themeRgb = getThemeRgb();
        if (searchActive && themeRgb) headerTextColor = contrastForRgb(themeRgb);
        else {
            let candidate = headerRoot.parentElement?.nextElementSibling;
            while (candidate && !candidate.hasAttribute?.("data-theme")) candidate = candidate.nextElementSibling;
            if (!candidate) {
                candidate = Array.from(document.querySelectorAll("[data-theme]"))
                    .find(el => headerRoot.compareDocumentPosition(el) & Node.DOCUMENT_POSITION_FOLLOWING);
            }
            const sectionTheme = (candidate as HTMLElement)?.dataset?.theme;
            const isDark = sectionTheme ? sectionTheme === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
            headerTextColor = isDark ? "#fff" : "#000";
        }

        ["mobile-header", "desktop-header", "desktop-title-bar"].forEach(i => {
            const el = id(i);
            if (el && headerTextColor != null) el.style.setProperty('--header-text', headerTextColor);
        });

        const navEl = id("desktop-header");
        if (navEl && headerTextColor != null && !navEl.style.getPropertyValue('--nav-text')) {
            navEl.style.setProperty('--nav-text', headerTextColor);
        }
    }

    ["DOMContentLoaded", "resize"].forEach(evt => {
        (evt === "DOMContentLoaded" ? document : window).addEventListener(evt, setHeaderTextColor);
    });

    function toggleVisibility(el: HTMLElement | null) {
        if (!el) return;
        const hidden = el.classList.contains("hidden");
        if (hidden) {
            el.classList.remove("hidden");
            setTimeout(() => el.classList.remove("opacity-0", "scale-95"), 10);
        } else {
            el.classList.add("opacity-0", "scale-95");
            el.addEventListener("transitionend", () => el.classList.add("hidden"), {once: true});
        }
    }

    (function bindMobileMenu() {
        const menu = id("mobile-menu");
        const hamburger = id("hamburger-menu");
        const closeBtn = q("#mobile-menu .material-symbols-outlined");
        [hamburger, closeBtn].forEach(btn => btn && btn.addEventListener("click", () => toggleVisibility(menu)));
    })();

    (function setupHeaderScroll() {
        const desktopHeader = id("desktop-header");
        const navIcons = id("desktop-nav-icons");

        const scrollBtn = document.createElement("button");
        scrollBtn.innerHTML = '<span class="material-symbols-outlined text-2xl">arrow_upward</span>';
        scrollBtn.setAttribute("aria-label", "Scroll to top");
        scrollBtn.className = [
            "scroll-to-top-btn",
            "flex",
            "items-center",
            "justify-center",
            "hover:bg-gray-200",
            "dark:hover:bg-zinc-700",
            "transition-all",
            "duration-200",
            "cursor-pointer",
            "z-50"
        ].join(" ");
        scrollBtn.addEventListener("click", () => window.scrollTo({top: 0, behavior: "smooth"}));
        if (navIcons && !navIcons.contains(scrollBtn)) navIcons.appendChild(scrollBtn);

        if (!desktopHeader) return;

        const SCROLL_LIMIT = 80;
        let target = 0, current = 0, ticking = false;
        const clamp = (v: number, a = 0, b = 1) => Math.max(a, Math.min(b, v));
        const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

        function updateTargetFromScroll() {
            if (!desktopHeader) return;
            const searchActive = desktopHeader.dataset.searchActive === "true";
            target = searchActive ? 1 : clamp(window.scrollY / SCROLL_LIMIT);
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(animate);
            }
        }

        const mo = new MutationObserver(() => {
            const searchActive = desktopHeader.dataset.searchActive === "true";
            target = searchActive ? 1 : clamp(window.scrollY / SCROLL_LIMIT);
            setHeaderTextColor();
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(animate);
            }
        });
        mo.observe(desktopHeader, {attributes: true, attributeFilter: ['data-search-active']});

        function animate() {
            const ease = 0.18;
            current = current + (target - current) * ease;
            applyHeaderStyles(current);
            if (Math.abs(target - current) > 0.001) requestAnimationFrame(animate);
            else {
                current = target;
                applyHeaderStyles(current);
                ticking = false;
            }
        }

        function applyHeaderStyles(p: number) {
            if (!desktopHeader) return;
            const searchActive = desktopHeader.dataset.searchActive === "true";
            const effectiveP = searchActive ? 1 : p;
            const isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;

            const alpha = lerp(0, 0.9, effectiveP);
            const lightBg = `rgba(255,255,255,${alpha})`;
            const darkBg = `rgba(24,25,26,${alpha})`;
            if (!desktopHeader) return;
            desktopHeader.style.backgroundColor = isDarkMode ? darkBg : lightBg;
            desktopHeader.style.backdropFilter = `saturate(${1 + effectiveP * 0.2}) blur(${effectiveP * 6}px)`;
            desktopHeader.style.top = `${lerp(48, 20, effectiveP)}px`;
            desktopHeader.style.boxShadow = effectiveP > 0 ? `0 6px 18px rgba(0,0,0,${0.12 * effectiveP})` : "none";
            desktopHeader.style.removeProperty('border-radius');

            const BG_VISIBLE_THRESHOLD = 0.02;
            const navEl = id("desktop-header");
            if (alpha > BG_VISIBLE_THRESHOLD) {
                const forcedText = isDarkMode ? "#fff" : "#000";
                if (navEl) navEl.style.setProperty('--nav-text', forcedText);
                headerTextColor = forcedText;
            } else {
                setHeaderTextColor();
                if (navEl && headerTextColor) navEl.style.setProperty('--nav-text', headerTextColor);
            }

            if (scrollBtn) {
                const btnOpacity = effectiveP;
                scrollBtn.style.opacity = `${btnOpacity}`;
                scrollBtn.style.pointerEvents = btnOpacity > 0.02 ? "auto" : "none";
                scrollBtn.style.transform = `translateY(${lerp(8, 0, effectiveP)}px)`;
            }
        }

        window.addEventListener("scroll", updateTargetFromScroll, {passive: true});
        window.addEventListener("resize", updateTargetFromScroll);
        updateTargetFromScroll();
    })();

    function highlightCurrentPage() {
        const anchors = document.querySelectorAll('a[data-key]');
        const path = window.location.pathname || '/';
        anchors.forEach(a => {
            const href = a.getAttribute('href') || '/';
            const match = href === path || (href !== '/' && path.startsWith(href));
            a.classList.toggle('opacity-100', match);
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        highlightCurrentPage();
        window.addEventListener('popstate', highlightCurrentPage);
        initSearchHandlers();
    });

    function debounce(fn: { (ev: any): void; apply?: any; }, delay = 180) {
        let t: string | number | NodeJS.Timeout | undefined;
        return (...args: any) => {
            clearTimeout(t);
            t = setTimeout(() => fn.apply(null, args), delay);
        };
    }

    async function loadSearchIndex() {
        if (searchLoaded) return;
        try {
            const res = await fetch('/search-index.json', {cache: 'no-cache'});
            if (!res.ok) {
                console.error('Failed to fetch index');
                return;
            }
            searchIndex = await res.json();
            fuse = new Fuse(searchIndex, {
                keys: [{name: 'title', weight: 0.7}, {name: 'description', weight: 0.3}, {
                    name: 'content',
                    weight: 0.2
                }],
                includeScore: true, threshold: 0.3, ignoreLocation: true
            });
            searchLoaded = true;
            console.log('Search index loaded, items:', searchIndex.length);
        } catch (err) {
            console.warn('Could not load search index, using fallback', err);
            searchIndex = [
                {title: "Home", description: "Welcome to the homepage", href: "/", content: ""},
                {title: "Stories", description: "Explore our stories", href: "/stories", content: ""}
            ];
            fuse = new Fuse(searchIndex, {keys: ['title', 'description', 'content'], threshold: 0.4});
            searchLoaded = true;
        }
    }

    function initSearchHandlers() {
        const inlineInput = id("search-input-inline");
        const modalInput = id("search-input");
        const debounced = debounce((ev) => performSearch(ev.target.value), 180);

        [inlineInput, modalInput].forEach(input => {
            if (!input) return;
            input.addEventListener("input", debounced);
            input.addEventListener("input", (ev) => {
                const target = ev.target as HTMLInputElement;
                toggleHeaderByInput(target.value || "");
            });
            addKeyHandlers(input as HTMLElement);
        });
    }

    document.addEventListener("keydown", (ev) => {
        if (ev.key !== "Escape") return;
        const modal = id("search-modal");
        const inline = id("desktop-inline-search");
        if (modal && !modal.classList.contains("hidden")) {
            closeSearchModal();
            return;
        }
        if (inline && !inline.classList.contains("hidden")) {
            closeInlineSearch();
            return;
        }
    });

    function addKeyHandlers(el: HTMLElement) {
        if (!el) return;
        el.addEventListener("keydown", (ev) => {
            if (ev.key === "ArrowDown") {
                ev.preventDefault();
                moveSelection(1);
            } else if (ev.key === "ArrowUp") {
                ev.preventDefault();
                moveSelection(-1);
            } else if (ev.key === "Enter") {
                ev.preventDefault();
                activateSelection();
            } else if (ev.key === "Escape") {
                closeInlineSearch();
                closeSearchModal();
            }
        });
    }

    function toggleHeaderByInput(value: string) {
        applyHeaderState(value && value.trim() !== "");
    }

    function applyHeaderState(active: string | boolean) {
        const hdr = id("desktop-header");
        if (!hdr) return;
        hdr.setAttribute("data-search-active", active ? "true" : "false");
        hdr.style.transition = hdr.style.transition || "border-radius 120ms cubic-bezier(.2,.9,.3,1), padding 120ms cubic-bezier(.2,.9,.3,1)";
        hdr.classList.toggle("rounded-2xl", !!active);
        hdr.classList.toggle("rounded-full", !active);
        setHeaderTextColor();
    }

    function chooseResultsContainer() {
        let results = id("search-results");
        let count = id("search-count");
        const inlineResults = id("search-results-inline");
        const inlineCount = id("search-count-inline");
        if ((!results || results.classList.contains('hidden')) && inlineResults) {
            results = inlineResults;
            count = inlineCount;
        }
        return {results, count};
    }

    function performSearch(query: (string | Expression) & (string | RegExp)) {
        const {results: resultsContainer, count: countEl} = chooseResultsContainer();
        selectedIndex = -1;
        currentResults = [];
        if (!resultsContainer || !countEl) return;
        resultsContainer.innerHTML = "";
        if (!query || typeof query !== "string" || !query.trim()) {
            countEl.classList.add("hidden");
            applyHeaderState(false);
            return;
        }
        if (!fuse) {
            countEl.textContent = 'Loading…';
            countEl.classList.remove('hidden');
            applyHeaderState(false);
            return;
        }

        const raw = Array.isArray(fuse.search(query, {limit: 50})) ? fuse.search(query, {limit: 50}) : [];
        const results = Array.isArray(raw) ? raw.map(r => r.item ? r.item : r) : [];
        currentResults = results;
        applyHeaderState(results.length > 0);
        countEl.textContent = `${results.length} Result${results.length === 1 ? "" : "s"}`;
        countEl.classList.remove("hidden");

        results.forEach((res, idx) => {
            const result = res as { title?: string; href?: string; description?: string };
            const el = document.createElement("div");
            el.className = "flex items-start gap-3 p-3 rounded-md hover:bg-gray-100 dark:hover:bg-zinc-800 cursor-pointer";
            el.setAttribute("role", "option");
            el.setAttribute("data-idx", String(idx));
            el.innerHTML = `
    <span class="material-symbols-outlined text-2xl text-gray-600 dark:text-gray-400">article</span>
    <div class="flex-1 min-w-0">
      <div class="flex justify-between items-center">
        <h3 class="text-sm font-semibold truncate">${escapeHtml(result.title ?? "")}</h3>
        <span class="text-xs text-gray-400 ml-3">${truncatePath(result.href ?? "")}</span>
      </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate">${escapeHtml(result.description || "")}</p>
      </div>
  `;
            el.addEventListener("click", () => navigateTo(result.href));
            el.addEventListener("mousemove", () => setSelection(idx));
            resultsContainer.appendChild(el);
        });
    }

    function toggleInlineSearch() {
        const nav = id("desktop-nav-groups");
        const inline = id("desktop-inline-search");
        if (!nav || !inline) return;
        const showing = !inline.classList.contains("hidden");
        if (showing) {
            inline.classList.add("hidden");
            nav.classList.remove("hidden");
            resetSearchInline();
        } else {
            nav.classList.add("hidden");
            inline.classList.remove("hidden");
            loadSearchIndex().catch(() => {
            });
            setTimeout(() => {
                const input = id("search-input-inline") as HTMLInputElement | null;
                if (input) {
                    input.value = "";
                    input.focus();
                    performSearch("");
                }
            }, 100);
        }
    }

    function resetSearchInline() {
        selectedIndex = -1;
        currentResults = [];
        const r = id("search-results-inline");
        const c = id("search-count-inline");
        if (r) r.innerHTML = "";
        if (c) c.classList.add("hidden");
        applyHeaderState(false);
    }

    function closeInlineSearch() {
        const inline = id("desktop-inline-search");
        const nav = id("desktop-nav-groups");
        if (!inline || !nav) return;
        inline.classList.add("hidden");
        nav.classList.remove("hidden");
        resetSearchInline();
    }

    function toggleSearchModal() {
        const modal = id("search-modal");
        if (!modal) return;
        const wasHidden = modal.classList.contains("hidden");
        toggleVisibility(modal);
        if (wasHidden) {
            loadSearchIndex().catch(() => {
            });
            setTimeout(() => {
                const input = id("search-input");
                if (input) {
                    (input as HTMLInputElement).value = "";
                    (input as HTMLInputElement).focus();
                    performSearch("");
                }
            }, 200);
        }
    }

    function closeSearchModal() {
        const modal = id("search-modal");
        if (!modal) return;
        modal.classList.add("opacity-0", "scale-95");
        modal.addEventListener("transitionend", () => modal.classList.add("hidden"), {once: true});
        const results = id("search-results");
        if (results) results.innerHTML = "";
        const count = id("search-count");
        if (count) count.classList.add("hidden");
        selectedIndex = -1;
        currentResults = [];
        applyHeaderState(false);
    }

    function moveSelection(delta: number) {
        if (!currentResults || currentResults.length === 0) return;
        let next = selectedIndex + delta;
        if (next < 0) next = currentResults.length - 1;
        if (next >= currentResults.length) next = 0;
        setSelection(next);
    }

    function setSelection(idx: number) {
        const container = id("search-results") || id("search-results-inline");
        if (!container) return;
        Array.from(container.children).forEach((c, i) => c.classList.toggle("bg-gray-100", i === idx));
        selectedIndex = idx;
        container.children[idx]?.scrollIntoView({block: "nearest"});
    }

    function activateSelection() {
        if (selectedIndex >= 0 && currentResults[selectedIndex]) navigateTo(currentResults[selectedIndex].href);
        else if (currentResults.length > 0) navigateTo(currentResults[0].href);
    }

    function navigateTo(href: string | undefined) {
        closeSearchModal();
        setTimeout(() => {
            if (href != null) window.location.href = href;
        }, 120);
    }

    function escapeHtml(unsafe = "") {
        return String(unsafe).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
    }

    function truncatePath(path = "") {
        if (!path) return "";
        return path.length > 20 ? path.slice(0, 18) + "…" : path;
    }

    window.toggleSearchModal = toggleSearchModal;
    window.toggleInlineSearch = toggleInlineSearch;
    window.closeInlineSearch = closeInlineSearch;
    window.closeSearchModal = closeSearchModal;
    window.performSearch = performSearch;

    declare global {
        interface Window {
            toggleSearchModal: typeof toggleSearchModal;
            toggleInlineSearch: typeof toggleInlineSearch;
            closeInlineSearch: typeof closeInlineSearch;
            closeSearchModal: typeof closeSearchModal;
            performSearch: typeof performSearch;
        }
    }
</script>

