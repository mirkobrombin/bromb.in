---
import { Icon } from "astro-icon/components";

const navItems = [
    { name: "HOME", href: "/", key: "home" },
    { name: "STORIES", href: "/stories", key: "stories" },
    { name: "CINEMA", href: "/cinema", key: "cinema" },
    { name: "TRAVELS", href: "/travels", key: "travels" },
    { name: "FOOD & DRINKS", href: "/food-drinks", key: "food-drinks" },
    { name: "BOOKS", href: "/books", key: "books" },
    { name: "WORK", href: "/work", key: "work" },
];

const navGroups = [
    {
        items: [0],
        class: "flex flex-row gap-4 md:gap-8 justify-center items-center",
    }, // main
    { items: [1, 2, 3, 4], class: "hidden md:flex flex-row gap-4" }, // secondary
    { items: [5, 6], class: "hidden md:flex flex-row gap-4" }, // tertiary
];

const socialLinks = [
    { name: "simple-icons:facebook", href: "#" },
    { name: "simple-icons:youtube", href: "#" },
    { name: "simple-icons:twitter", href: "#" },
    { name: "simple-icons:instagram", href: "#" },
];

const footerLinks = [
    { name: "ABOUT", href: "/about" },
    { name: "CONTACT US", href: "/contact" },
];

export let currentPage = null;
---

<div
    class="flex items-center justify-between px-4 h-18 md:h-16 lg:hidden"
    id="mobile-header"
>
    <h1 class="text-3xl font-semibold font-sans">bromb.in</h1>
    <button
        id="hamburger-menu"
        class="material-symbols-outlined text-4xl"
        onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
    >
        menu
    </button>
</div>

<div class="fixed w-full z-50">
    <div
        id="mobile-menu"
        class="hidden font-sans fixed top-0 left-0 w-full h-full bg-primary/80 backdrop-blur-md flex flex-col items-center justify-center text-black transition-all duration-300 opacity-0 transform scale-95"
    >
        <button
            class="absolute top-5 right-4 material-symbols-outlined text-3xl"
            onclick="document.getElementById('mobile-menu').classList.toggle('hidden')"
        >
            close
        </button>
        <nav class="flex flex-col gap-4 text-lg font-medium font-sans">
            {
                navItems.map((item) => (
                    <a
                        href={item.href}
                        data-key={item.key}
                        class={`hover:underline ${currentPage === item.key ? "font-extrabold" : ""}`}
                    >
                        {item.name}
                    </a>
                ))
            }
        </nav>
        <div class="flex flex-col items-center gap-4 mt-8">
            <div class="flex gap-4">
                {
                    socialLinks.map((icon) => (
                        <a href={icon.href} class="hover:opacity-75">
                            <Icon name={icon.name} />
                        </a>
                    ))
                }
            </div>
            <div class="flex gap-2 justify-center md:justify-start">
                {
                    footerLinks.map((item) => (
                        <a href={item.href} class="hover:underline">
                            {item.name}
                        </a>
                    ))
                }
            </div>
        </div>
    </div>

    <!-- Desktop -->
    <div class="hidden lg:flex w-full items-center justify-center">
        <div
            class="hidden lg:flex w-max h-12 items-end justify-center text-sm font-medium md:h-16 transition-all duration-300"
        >
            <nav
                class="flex flex-row gap-4 items-center justify-between font-sans text-md px-4 py-2 md:gap-12 md:px-8 rounded-full"
                id="desktop-header"
            >
                {
                    navGroups.map((group) => (
                        <div class={group.class}>
                            {group.items.map((i) => (
                                <a
                                    href={navItems[i].href}
                                    data-key={navItems[i].key}
                                    class={`hover:underline ${currentPage === navItems[i].key ? "font-extrabold" : ""}`}
                                >
                                    {navItems[i].name}
                                </a>
                            ))}
                        </div>
                    ))
                }
                <button
                    id="search-button"
                    class="hover:underline flex items-center justify-center"
                    onclick="toggleSearchModal()"
                >
                    <span class="material-symbols-outlined text-xl">search</span
                    >
                </button>
            </nav>
        </div>
    </div>
</div>

<div
    class="hidden lg:flex flex-col md:flex-row justify-between items-center md:items-end px-4 md:px-12 pb-2 font-sans w-full pt-8 md:pt-12"
    id="desktop-title-bar"
>
    <h1 class="text-4xl md:text-5xl font-semibold text-center md:text-left">
        bromb.in
    </h1>
    <div class="flex flex-col md:flex-row gap-2 mt-4 md:mt-0">
        <div class="flex gap-2 justify-center md:justify-start">
            {
                socialLinks.map((icon) => (
                    <a href={icon.href} class="hover:opacity-75">
                        <Icon name={icon.name} />
                    </a>
                ))
            }
        </div>
        <div class="flex gap-2 justify-center md:justify-start">
            {
                footerLinks.map((item) => (
                    <a href={item.href} class="hover:underline">
                        {item.name}
                    </a>
                ))
            }
        </div>
    </div>
</div>

<!-- Search modal (desktop & tablet) -->
<div
    id="search-modal"
    class="hidden fixed inset-0 z-60 flex items-start justify-center px-4 pt-24 font-sans"
>
    <div
        class="absolute inset-0 bg-black/40"
        id="search-backdrop"
        onclick="closeSearchModal()"
    >
    </div>

    <div
        class="relative z-70 w-full max-w-3xl rounded-xl bg-white/95 dark:bg-zinc-900/95 shadow-xl px-4 pt-4 md:px-4 md:pt-4 transform transition-all duration-250 scale-95 opacity-0 h-max"
        id="search-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="search-label"
    >
        <div class="flex items-center gap-3">
            <button
                class="absolute left-4 top-2 flex items-center justify-center p-2 hover:bg-gray-200 dark:hover:bg-zinc-800 rounded-full"
                aria-label="Close search"
                onclick="closeSearchModal()"
                aria-hidden="true">
                    <Icon name="material-symbols:search" class="size-6" />
                </button
            >
            <input
                id="search-input"
                class="w-full h-7 bg-transparent outline-none text-sm md:text-lg text-center font-semibold"
                placeholder="What are you looking for?"
                aria-label="Search"
            />
            <div id="search-count" class="text-sm text-gray-500 hidden">
                0 Results
            </div>
        </div>

        <div
            id="search-results"
            class="mt-4 max-h-64 overflow-auto space-y-2"
            role="listbox"
            tabindex="-1"
        >
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/fuse.js@6.6.2/dist/fuse.min.js"></script>

<script>
    let headerTextColor = null;

    function setHeaderTextColor() {
        const header = document.querySelector(".fixed.w-full.z-50");
        let section = null;
        if (header) {
            let candidate = null,
                next = header.parentElement?.nextElementSibling;
            while (next) {
                if (next.hasAttribute("data-theme")) {
                    candidate = next;
                    break;
                }
                next = next.nextElementSibling;
            }
            if (!candidate) {
                candidate = Array.from(
                    document.querySelectorAll("[data-theme]"),
                ).find(
                    (el) =>
                        header.compareDocumentPosition(el) &
                        Node.DOCUMENT_POSITION_FOLLOWING,
                );
            }
            section = candidate;
        }
        let textColor;
        if (section instanceof HTMLElement && section.dataset.theme)
            textColor = section.dataset.theme === "dark" ? "#fff" : "#000";
        else
            textColor = window.matchMedia("(prefers-color-scheme: dark)")
                .matches
                ? "#fff"
                : "#000";
        headerTextColor = textColor;
        ["mobile-header", "desktop-header", "desktop-title-bar"].forEach(
            (id) => {
                const el = document.getElementById(id);
                if (el && headerTextColor !== null)
                    el.style.color = headerTextColor;
            },
        );
    }

    ["DOMContentLoaded", "resize", "scroll"].forEach((evt) =>
        (evt === "DOMContentLoaded" ? document : window).addEventListener(
            evt,
            setHeaderTextColor,
        ),
    );

    function toggleVisibility(el) {
        if (!el) return;
        const hidden = el.classList.contains("hidden");
        if (hidden) {
            el.classList.remove("hidden");
            setTimeout(() => {
                el.classList.remove("opacity-0", "scale-95");
                const panel = document.getElementById("search-panel");
                if (panel) {
                    panel.classList.remove("opacity-0", "scale-95");
                    panel.classList.add("opacity-100", "scale-100");
                }
            }, 10);
        } else {
            el.classList.add("opacity-0", "scale-95");
            const panel = document.getElementById("search-panel");
            if (panel) {
                panel.classList.remove("opacity-100", "scale-100");
                panel.classList.add("opacity-0", "scale-95");
            }
            el.addEventListener(
                "transitionend",
                () => el.classList.add("hidden"),
                { once: true },
            );
        }
    }

    const menu = document.getElementById("mobile-menu");
    const hamburgerBtn = document.getElementById("hamburger-menu");
    const closeBtn = document.querySelector(
        "#mobile-menu .material-symbols-outlined",
    );
    [hamburgerBtn, closeBtn].forEach(
        (btn) =>
            btn && btn.addEventListener("click", () => toggleVisibility(menu)),
    );

    const desktopHeader = document.getElementById("desktop-header");
    let lastScrollY = window.scrollY;
    window.addEventListener("scroll", () => {
        if (!desktopHeader) return;
        const isDarkMode = window.matchMedia(
            "(prefers-color-scheme: dark)",
        ).matches;
        const classes = [
            "bg-white/90",
            "dark:bg-zinc-800/90",
            "backdrop-blur-md",
            "shadow-lg",
            "transition-all",
            "duration-300",
            "ease-in-out",
        ];
        if (window.scrollY > lastScrollY) {
            desktopHeader.classList.add(...classes);
            desktopHeader.style.color = isDarkMode ? "white" : "black";
        } else if (window.scrollY === 0) {
            desktopHeader.classList.remove(...classes);
            desktopHeader.style.color = headerTextColor ?? (isDarkMode ? "white" : "black");
        }
        lastScrollY = window.scrollY;
    });

    function highlightCurrentPage() {
        const anchors = document.querySelectorAll('a[data-key]');
        const path = window.location.pathname || '/';
        anchors.forEach(a => {
            const href = a.getAttribute('href') || '/';
            let match = false;
            if (href === path) match = true;
            else if (href !== '/' && path.startsWith(href)) match = true;
            else if (href === '/' && path === '/') match = true;
            if (match) a.classList.add('font-extrabold');
            else a.classList.remove('font-extrabold');
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        highlightCurrentPage();
        window.addEventListener('popstate', highlightCurrentPage);

        initSearchModal();
    });

    /* -----------------------
       Search modal & logic (Fuse-based)
       ----------------------- */

    let searchIndex = [];
    let fuse = null;
    let searchLoaded = false;

    let searchTimeout = null;
    let selectedIndex = -1;
    let currentResults = [];

    function debounce(fn, delay) {
        let t;
        return function(...args) {
            clearTimeout(t);
            t = setTimeout(() => fn.apply(null, args), delay);
        };
    }

    async function loadSearchIndex() {
        if (searchLoaded) return;
        try {
            const res = await fetch('/search-index.json', { cache: 'no-cache' });
            if (!res.ok) throw new Error('Failed to fetch index');
            searchIndex = await res.json();
            // fuse options — tune threshold for fuzzy results
            fuse = new Fuse(searchIndex, {
                keys: [
                    { name: 'title', weight: 0.7 },
                    { name: 'description', weight: 0.3 },
                    { name: 'content', weight: 0.2 },
                ],
                includeScore: true,
                threshold: 0.3,
                ignoreLocation: true,
            });
            searchLoaded = true;
            console.log('Search index loaded, items:', searchIndex.length);
        } catch (err) {
            console.warn('Could not load search index, falling back to simple in-memory index', err);
            // optional fallback: small built-in index
            searchIndex = [
                { title: "Home", description: "Welcome to the homepage", href: "/", content: "" },
                { title: "Stories", description: "Explore our stories", href: "/stories", content: "" },
            ];
            fuse = new Fuse(searchIndex, { keys: ['title','description','content'], threshold: 0.4 });
            searchLoaded = true;
        }
    }

    function initSearchModal() {
        const input = document.getElementById("search-input");
        const modal = document.getElementById("search-modal");
        if (!input || !modal) return;

        // Debounced input handler
        const debounced = debounce((ev) => {
            performSearch((ev.target).value);
        }, 180);

        input.addEventListener("input", debounced);

        // Keyboard handling for results navigation
        input.addEventListener("keydown", (ev) => {
            if (ev.key === "ArrowDown") {
                ev.preventDefault();
                moveSelection(1);
            } else if (ev.key === "ArrowUp") {
                ev.preventDefault();
                moveSelection(-1);
            } else if (ev.key === "Enter") {
                ev.preventDefault();
                activateSelection();
            } else if (ev.key === "Escape") {
                closeSearchModal();
            }
        });

        // Close on Escape from anywhere inside panel
        const panel = document.getElementById("search-panel");
        panel?.addEventListener("keydown", (ev) => {
            if (ev.key === "Escape") closeSearchModal();
        });
    }

    async function toggleSearchModal() {
        const modal = document.getElementById("search-modal");
        if (!modal) return;
        const wasHidden = modal.classList.contains("hidden");
        toggleVisibility(modal);

        if (wasHidden) {
            // load index the first time (async)
            loadSearchIndex().catch(() => {});
            setTimeout(() => {
                const input = document.getElementById("search-input");
                if (input) {
                    input.value = "";
                    input.focus();
                    performSearch(""); // clear results
                }
            }, 200);
        }
    }

    function closeSearchModal() {
        const modal = document.getElementById("search-modal");
        if (!modal) return;
        // animate out then hide
        modal.classList.add("opacity-0", "scale-95");
        modal.addEventListener(
            "transitionend",
            () => modal.classList.add("hidden"),
            { once: true },
        );
        // remove results and reset selection after close
        const results = document.getElementById("search-results");
        if (results) results.innerHTML = "";
        const count = document.getElementById("search-count");
        if (count) count.classList.add("hidden");
        selectedIndex = -1;
        currentResults = [];
    }

    function performSearch(query) {
        const resultsContainer = document.getElementById("search-results");
        const countEl = document.getElementById("search-count");
        selectedIndex = -1;
        currentResults = [];
        if (!resultsContainer || !countEl) return;
        resultsContainer.innerHTML = "";

        if (!query || query.trim() === "") {
            countEl.classList.add("hidden");
            return;
        }

        const q = query.trim();
        if (!fuse) {
            // if fuse isn't ready yet, simply show "loading" or fallback
            countEl.textContent = 'Loading…';
            countEl.classList.remove('hidden');
            return;
        }

        const raw = fuse.search(q, { limit: 50 });
        const results = raw.map(r => (r.item ? r.item : r));

        currentResults = results;

        countEl.textContent = `${results.length} Result${results.length === 1 ? "" : "s"}`;
        countEl.classList.remove("hidden");

        results.forEach((res, idx) => {
            const el = document.createElement("div");
            el.className = "flex items-start gap-3 p-3 rounded-md hover:bg-gray-100 dark:hover:bg-zinc-800 cursor-pointer";
            el.setAttribute("role", "option");
            el.setAttribute("data-idx", String(idx));

            el.innerHTML = `
      <span class="material-symbols-outlined text-2xl text-gray-600 dark:text-gray-400">article</span>
      <div class="flex-1 min-w-0">
        <div class="flex justify-between items-center">
          <h3 class="text-sm font-semibold truncate">${escapeHtml(res.title)}</h3>
          <span class="text-xs text-gray-400 ml-3">${truncatePath(res.href)}</span>
        </div>
        <p class="text-xs text-gray-500 dark:text-gray-400 truncate">${escapeHtml(res.description || '')}</p>
      </div>
    `;

            el.addEventListener("click", () => {
                navigateTo(res.href);
            });

            el.addEventListener("mousemove", () => {
                setSelection(idx);
            });

            resultsContainer.appendChild(el);
        });

        selectedIndex = -1;
    }

    function moveSelection(delta) {
        if (!currentResults || currentResults.length === 0) return;
        let next = selectedIndex + delta;
        if (next < 0) next = currentResults.length - 1;
        if (next >= currentResults.length) next = 0;
        setSelection(next);
    }

    function setSelection(idx) {
        const resultsContainer = document.getElementById("search-results");
        if (!resultsContainer) return;
        const children = Array.from(resultsContainer.children);
        children.forEach((c, i) => {
            if (i === idx) {
                c.classList.add("bg-gray-100", "dark:bg-zinc-800");
                c.scrollIntoView({ block: "nearest" });
            } else {
                c.classList.remove("bg-gray-100", "dark:bg-zinc-800");
            }
        });
        selectedIndex = idx;
    }

    function activateSelection() {
        if (selectedIndex >= 0 && currentResults[selectedIndex]) {
            navigateTo(currentResults[selectedIndex].href);
        } else {
            if (currentResults.length > 0) navigateTo(currentResults[0].href);
        }
    }

    function navigateTo(href) {
        closeSearchModal();
        setTimeout(() => {
            window.location.href = href;
        }, 120);
    }

    function escapeHtml(unsafe) {
        return unsafe
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;");
    }

    function truncatePath(path) {
        if (!path) return "";
        if (path.length > 20) return path.slice(0, 18) + "…";
        return path;
    }

    // Expose handlers to inline onclick attributes
    window.toggleSearchModal = toggleSearchModal;
    window.closeSearchModal = closeSearchModal;
    window.performSearch = performSearch;
</script>
