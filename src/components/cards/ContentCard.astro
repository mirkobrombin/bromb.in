---
export interface Props {
  href: string;
  image?: string;
  title?: string;
  author?: string;
  date?: string;
  excerpt?: string;
  reverse?: boolean;
  imageClasses?: string;
  metaHtml?: any;
  popcornScore?: number;
  totalPopcorns?: number;
}

export let href = '#';
export let image = '';
export let title = '';
export let author = '';
export let date = '';
export let excerpt = '';
export let reverse = false;
export let imageClasses = 'w-1/2 rounded-sm overflow-hidden shadow-lg';
export let metaHtml = null;
export let popcornScore: number | null = null;
export let totalPopcorns = 5;
---

<div class={`flex flex-col md:flex-row ${reverse ? 'md:flex-row-reverse' : ''} items-start md:items-center gap-6 w-full border-b border-zinc-200 dark:border-zinc-700 pb-6`}>
  <a href={href} class={`md:flex-1 w-full lg:max-w-1/2 ${imageClasses}`}>
    <img src={image} alt={title} loading="lazy" class="w-full h-56 md:h-auto object-cover transform hover:scale-105 transition-transform duration-300" />
  </a>

  <div class="flex-1 flex flex-col gap-3">
    <h2 class="text-2xl md:text-5xl font-medium text-zinc-900 dark:text-zinc-100 transition-colors duration-200">
      <a href={href} class="inline-block">{title}</a>
    </h2>
    {author || date ? (
      <p class="text-sm md:text-2xl text-zinc-600 dark:text-zinc-400 transition-colors duration-200">
        {author && <span>by {author} – </span>}
        {date && <span class="text-xs md:text-base text-zinc-500 dark:text-zinc-300">{date}</span>}
      </p>
    ) : null}

    {metaHtml ? (
      <p class="text-sm">{metaHtml}</p>
    ) : null}

    {excerpt ? (
      <p class="text-sm md:text-base text-zinc-800 dark:text-zinc-300 transition-colors duration-200">{excerpt}</p>
    ) : null}

    {popcornScore != null ? (
      <div class="center-wrap w-max">
        <div class="center-wrap gap-1 bg-red-50 px-4 py-1 rounded-full">
          {Array.from({length: totalPopcorns}).map((_, i) => (
            <span class={`text-lg ${i < popcornScore ? 'opacity-100' : 'opacity-20'}`}>🍿</span>
          ))}
          <span class="text-red-600 font-medium text-base ml-2">{popcornScore}/{totalPopcorns}</span>
        </div>
      </div>
    ) : null}

    <div class="center-wrap flex-row gap-2 w-max">
      <a class="center-wrap rounded-full bg-black text-white p-2">
        <slot name="share-icon">
          <span class="material-symbols-outlined text-base">share</span>
        </slot>
      </a>
    </div>
  </div>
</div>
