---
import SearchBar from './SearchBar.astro';

export interface Props {
  navGroups: { items: number[]; class: string }[];
  navItems: { key: string; trans: string }[];
  currentLang: string;
  t: (key: string) => string;
  getRelativeLocaleUrl: (lang: string, path: string) => string;
}

// safe defaults and imports
const {
  navGroups = [],
  navItems = [],
  currentLang = 'en',
  t = (k: string) => k,
  getRelativeLocaleUrl = (_lang: string, path: string) => `/${path}`,
} = Astro.props as Partial<Props>;
---

<nav id="desktop-header"
     class="absolute left-1/2 transform -translate-x-1/2 top-12 hidden lg:flex flex-row gap-4 items-center justify-between font-sans text-md px-4 py-2 md:gap-12 md:px-8 rounded-full w-max">
    <div id="desktop-nav-groups" class="flex items-center gap-8">
        {navGroups.map(group => (
                <div class={group.class}>
                    {group.items.map(i => (
                            <a href={getRelativeLocaleUrl(currentLang, navItems[i].key === 'home' ? '' : navItems[i].key)}
                               data-key={navItems[i].key}
                               class="hover:underline opacity-80">{t('nav.' + navItems[i].trans)}</a>
                    ))}
                </div>
        ))}

        <div class="hidden md:flex flex-row gap-4" id="desktop-nav-icons">
            <button id="search-button" class="hover:underline flex items-center justify-center"
                    onclick="toggleInlineSearch()"
                    type="button">
                <span class="material-symbols-outlined text-xl">search</span>
            </button>
        </div>
    </div>

    <SearchBar />
</nav>
