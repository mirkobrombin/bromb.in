---
import { Icon } from "astro-icon/components";

export interface Props {}
---

<div id="desktop-inline-search" class="hidden flex-col w-full min-w-[min(640px,70vw)]">
    <div class="search-input-row flex items-center gap-3 px-4 py-2.5 rounded-full">
        <button
                class="flex items-center justify-center hover:bg-gray-200 dark:hover:bg-zinc-700 rounded-full p-1"
                onclick="closeInlineSearch()"
                aria-label="Close inline search"
                type="button"
        >
            <Icon name="material-symbols:search" class="size-5"/>
        </button>
        <input
                id="search-input-inline"
                class="flex-1 bg-transparent outline-none text-sm md:text-base text-center font-medium"
                placeholder="What are you looking for?"
                aria-label="Search"
        />
        <span id="search-count-inline" class="text-sm text-gray-500 dark:text-zinc-300 shrink-0 hidden">0 Results</span>
    </div>

    <div
            id="search-results-inline"
            class="hidden mt-2 rounded-2xl shadow-lg max-h-80 overflow-y-auto"
            role="listbox"
            tabindex="-1"
    ></div>
</div>
