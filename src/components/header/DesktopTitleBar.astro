---
import { Icon } from "astro-icon/components";
import LanguagePicker from '../LanguagePicker.astro';

export interface Props {
  currentLang: string;
  t: (key: string) => string;
  aboutUrl: string;
}

const {
  currentLang = 'en',
  t = (k: string) => k,
  aboutUrl = '/about',
} = Astro.props as Partial<Props>;
---

<div id="desktop-title-bar"
     class="hidden lg:flex flex-col md:flex-row justify-between items-center md:items-center pb-2 font-sans w-[90vw] lg:w-[70vw] mx-auto lg:max-w-305 py-12">
    <h1 class="text-4xl md:text-5xl font-semibold text-center md:text-left">bromb.in</h1>
    <div class="flex flex-col md:flex-row items-center justify-center gap-2 mt-4 md:mt-0">
        <div class="flex gap-6 justify-center items-center">
            <div class="relative group">
                <button id="lang-btn"
                        class="bg-white/80 dark:bg-zinc-800/90 backdrop-blur-xs text-black dark:text-white rounded-full py-2 px-5 hover:bg-gray-200 dark:hover:bg-zinc-700 transition flex items-center justify-center gap-3">
                    <Icon name="material-symbols:language" class="size-5 inline-block"/>
                    <span>{currentLang.toUpperCase()}</span>
                </button>
                <div id="lang-popup"
                     class="absolute text-black dark:text-white left-0 mt-2 min-w-22.705 bg-white/90 dark:bg-zinc-800/95 backdrop-blur-xs rounded-xl shadow-lg border border-gray-200 dark:border-zinc-700 py-2 px-3 z-50 hidden">
                    <LanguagePicker/>
                </div>
            </div>
            <a href={aboutUrl} class="hover:underline opacity-80 h-max">{t('nav.about')}</a>
        </div>
    </div>
</div>
