---
import LanguagePicker from '../LanguagePicker.astro';

export interface Props {
  navItems: { key: string; trans: string; disabled?: boolean }[];
  currentPage: string | null;
  currentLang: string;
  t: (key: string) => string;
  getRelativeLocaleUrl: (lang: string, path: string) => string;
  aboutUrl: string;
}

const {
  navItems = [],
  currentPage = null,
  currentLang = 'en',
  t = (k: string) => k,
  getRelativeLocaleUrl = (_lang: string, path: string) => `/${path}`,
  aboutUrl = '/about',
} = Astro.props as Partial<Props>;
---

<div class="flex items-center justify-between px-4 h-18 md:h-16 lg:hidden" id="mobile-header">
    <h1 class="text-3xl font-semibold font-sans">bromb.in</h1>
    <div class="flex items-center gap-2">
        <button id="mobile-search-button" class="material-symbols-outlined text-3xl" type="button" aria-label="Open search">search</button>
        <button id="hamburger-menu" class="material-symbols-outlined text-4xl" type="button" aria-label="Open menu">menu</button>
    </div>
</div>

<div id="mobile-search-overlay" class="hidden fixed inset-0 z-40 bg-black/20 backdrop-blur-sm" onclick="closeMobileSearch()"></div>
<div id="mobile-inline-search" class="hidden fixed top-18 left-0 right-0 z-50 px-4 lg:hidden">
    <div class="bg-white/95 dark:bg-zinc-900/95 rounded-2xl shadow-lg p-3">
        <div class="search-input-row flex items-center gap-3 px-4 py-2.5 bg-gray-100 dark:bg-zinc-800 rounded-full">
            <button
                    class="flex items-center justify-center hover:bg-gray-200 dark:hover:bg-zinc-700 rounded-full p-1"
                    onclick="closeMobileSearch()"
                    aria-label="Close mobile search"
                    type="button"
            >
                <span class="material-symbols-outlined text-xl">search</span>
            </button>
            <input
                    id="search-input-mobile"
                    class="flex-1 bg-transparent outline-none text-sm text-center font-medium"
                    placeholder="What are you looking for?"
                    aria-label="Search"
            />
            <span id="search-count-mobile" class="text-sm text-gray-500 dark:text-zinc-300 shrink-0 hidden">0 Results</span>
        </div>
        <div
                id="search-results-mobile"
                class="hidden mt-2 bg-white dark:bg-zinc-900 rounded-2xl max-h-80 overflow-y-auto"
                role="listbox"
                tabindex="-1"
        ></div>
    </div>
</div>

<div id="mobile-menu"
     class="hidden font-sans fixed top-0 left-0 w-full h-full bg-primary/80 backdrop-blur-md flex-col items-center justify-center text-black transition-all duration-300 opacity-0 transform scale-95">
    <button id="mobile-menu-close" class="absolute top-5 right-4 material-symbols-outlined text-3xl">close</button>

    <div class="w-[90vw] md:w-[70vw] mx-auto flex flex-col items-center justify-center gap-6">
        <nav class="flex flex-col gap-4 text-lg font-medium font-sans w-full text-center">
            {navItems
              .filter((item) => !item.disabled)
              .map((item) => (
                <a
                  href={getRelativeLocaleUrl(currentLang, item.key === 'home' ? '' : item.key)}
                  data-key={item.key}
                  class={`hover:underline ${currentPage === item.key ? 'font-extrabold' : ''}`}
                >
                  {t('nav.' + item.trans)}
                </a>
              ))}
        </nav>

        <div class="flex flex-col items-center gap-4 mt-2 w-full">
            <div class="flex gap-4 justify-center items-center">
                <div class="relative">
                    <div class="bg-white/80 dark:bg-zinc-800/90 backdrop-blur-xs text-black dark:text-white rounded-2xl py-2 px-4">
                        <LanguagePicker/>
                    </div>
                </div>
                <a href={aboutUrl} class="hover:underline">{t('nav.about')}</a>
            </div>
        </div>
    </div>
</div>
