---
export interface Props {}
import { Icon } from "astro-icon/components";
---

<div id="headings-toggle" class="relative flex items-end transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] w-12 h-12 sm:w-14 sm:h-14 rounded-full group overflow-visible" style="cursor:pointer;">
	<div id="headings-list-container" class="absolute -left-1 bottom-0 ml-2 px-2 sm:px-4 pt-6 pb-12 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] flex flex-col items-start bg-white/70 dark:bg-zinc-800/80 shadow-sm rounded-3xl w-64 sm:w-72 max-h-80 sm:max-h-96 z-10 backdrop-blur-xs group-hover:opacity-100 group-hover:pointer-events-auto">
		<ul id="headings-list" class="w-full space-y-1 overflow-y-auto scrollbar-thin scrollbar-thumb-zinc-800 dark:scrollbar-thumb-zinc-600 scrollbar-track-rounded-full scrollbar-track-zinc-100 dark:scrollbar-track-zinc-800"></ul>
	</div>
	<div class="ui-pill w-12 h-12 sm:w-14 sm:h-14 z-99 bg-white/70 dark:bg-zinc-800/80 shadow-sm rounded-full transition backdrop-blur-xs">
		<Icon name="material-symbols:text-fields" class="icon-lg" />
	</div>
</div>
