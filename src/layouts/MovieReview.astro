---
import Layout from "./Layout.astro";
import {Icon} from "astro-icon/components";
import "../styles/global.css";

const {frontmatter, prevSlug, nextSlug, readingTime} = Astro.props;

const title = frontmatter.title || "Unset";
const author = frontmatter.author || "Mirko & Laura";
const movieRelease = frontmatter.movieRelease || "2024";
const popcornScore = frontmatter.popcornScore || 5;
const movieCategory = frontmatter.movieCategory || "Drama";
const movieLength = frontmatter.movieLength || "6 seasons";
const movieCover = frontmatter.movieCover || "https://placehold.co/300x450/png";
const date = frontmatter.date || "2024-01-01";

const totalPopcorns = 5;

const reviewFiles = import.meta.glob("../pages/cinema/reviews/*.md");
const reviewEntries = Object.entries(reviewFiles);
const reviewPosts = await Promise.all(
  reviewEntries.map(async ([path, loader]) => {
    const mod = await loader();
    const file = path.split("/").pop() || "";
    const slugFromFile = file.replace(".md", "");
    const titleFromFile = String(mod?.frontmatter?.title ?? slugFromFile).trim();
    return { slug: slugFromFile, title: titleFromFile };
  })
);
const titleToSlug = new Map(reviewPosts.map(p => [p.title.toLowerCase(), p.slug]));
function resolveManualRef(value: any) {
  if (!value) return null;
  const s = String(value).trim();
  if (!s) return null;
  const byTitle = titleToSlug.get(s.toLowerCase());
  if (byTitle) return byTitle;
  // fallback
  if (reviewPosts.find(p => p.slug === s)) return s;
  return null;
}
const fmPrevResolved = resolveManualRef(frontmatter?.prev);
const fmNextResolved = resolveManualRef(frontmatter?.next);
const effectivePrevSlug = prevSlug ?? fmPrevResolved ?? null;
const effectiveNextSlug = nextSlug ?? fmNextResolved ?? null;
---

<Layout>
    <div class="flex flex-row gap-8 items-end mb-20 mt-5">
        <img
                src={movieCover}
                alt={title}
                class="w-2/5 h-auto rounded-sm shadow-lg dark:shadow-none"
        />
        <div class="flex flex-col gap-4">
            <h1 class="text-6xl font-normal max-w-100 dark:text-white">
                {title}
            </h1>
            <p class="text-4xl dark:text-zinc-300">
                by {author} - <small class="text-lg dark:text-zinc-400"
            >{date}</small
            >
            </p>
            <p class="text-sm dark:text-zinc-400">
                {movieRelease} &#8226; {movieCategory} &#8226; {movieLength}
            </p>

            <div class="flex items-center justify-center w-max">
                <div
                        class="flex items-center gap-1 bg-red-50 dark:bg-red-900/30 px-4 py-1 rounded-full"
                >
                    {
                        Array.from({length: totalPopcorns}).map((_, i) => (
                                <span
                                        class={`text-lg ${i < popcornScore ? "opacity-100" : "opacity-20"}`}
                                >
                                🍿
                            </span>
                        ))
                    }
                    <span
                            class="text-red-600 dark:text-red-400 font-medium text-base ml-2"
                    >{popcornScore}/{totalPopcorns}</span
                    >
                </div>
            </div>

            <div class="flex flex-row gap-2 items-center justify-center w-max">
                <a
                        class="flex items-center justify-center rounded-full bg-black text-white p-2 dark:bg-white dark:text-black"
                >
                    <Icon
                            name="material-symbols:share"
                            class="text-base dark:text-black"
                    />
                </a>
            </div>
        </div>
    </div>

    <div class="flex w-full items-center justify-center">
        <div class="flex flex-col prose dark:prose-invert min-w-full lg:prose-md lg:prose-p:text-xl">
            <slot/>
        </div>
    </div>

    <div
            class="fixed w-full bottom-8 left-0 flex items-center justify-center gap-5"
    >
        <div
                class="flex rounded-full bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xs dark:backdrop-blur-xs shadow-sm dark:shadow-md overflow-hidden h-full"
        >
            <a
                    id="prev-article-btn"
                    data-slug={effectivePrevSlug}
                    class={`flex items-center justify-center py-4 px-6 hover:bg-gray-200 dark:hover:bg-zinc-800 transition border-r border-r-zinc-200 dark:border-r-zinc-700 ${!effectivePrevSlug ? "pointer-events-none opacity-30" : ""}`}
                    href={effectivePrevSlug ? `/cinema/reviews/${effectivePrevSlug}` : undefined}
                    aria-disabled={!effectivePrevSlug}
                    tabindex={!effectivePrevSlug ? -1 : undefined}
            >
                <Icon
                        name="material-symbols:arrow-back"
                        class="text-2xl dark:text-white"
                />
            </a>
            <a
                    id="next-article-btn"
                    data-slug={effectiveNextSlug}
                    class={`flex items-center justify-center py-4 px-6 hover:bg-gray-200 dark:hover:bg-zinc-800 transition ${!effectiveNextSlug ? "pointer-events-none opacity-30" : ""}`}
                    href={effectiveNextSlug ? `/cinema/reviews/${effectiveNextSlug}` : undefined}
                    aria-disabled={!effectiveNextSlug}
                    tabindex={!effectiveNextSlug ? -1 : undefined}
            >
                <Icon
                        name="material-symbols:arrow-forward"
                        class="text-2xl dark:text-white"
                />
            </a>
        </div>
        <div
                class="flex rounded-full bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xs dark:backdrop-blur-xs shadow-sm dark:shadow-md overflow-hidden items-center justify-center py-4 px-8"
                id="reading-time-container"
        >
            <Icon
                    name="material-symbols:schedule-outline"
                    class="text-lg dark:text-white"
            />
            <span
                    class="ml-2 text-lg font-normal dark:text-white"
                    id="reading-time-text"
                    data-reading-time={readingTime}
            >{readingTime} min left</span
            >
        </div>
        <div
                id="headings-toggle"
                class="relative flex items-end transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] w-14 h-14 rounded-full group overflow-visible"
                style="cursor:pointer;"
        >
            <div
                    id="headings-list-container"
                    class="absolute -left-1 bottom-0 ml-2 px-4 pt-6 pb-12 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] flex flex-col items-start bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xs shadow-sm dark:shadow-md rounded-3xl w-72 max-h-96 z-10"
            >
                <ul
                        id="headings-list"
                        class="w-full space-y-1 overflow-y-auto scrollbar-thin scrollbar-thumb-zinc-800 dark:scrollbar-thumb-zinc-500 scrollbar-track-rounded-full scrollbar-track-zinc-100 dark:scrollbar-track-zinc-800"
                >
                </ul>
            </div>
            <div
                    class="flex items-center justify-center w-14 h-14 z-99 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-xs dark:backdrop-blur-xs shadow-sm dark:shadow-md rounded-full transition"
            >
                <Icon
                        name="material-symbols:text-fields"
                        class="text-2xl dark:text-white"
                />
            </div>
        </div>
    </div>
</Layout>

<script>
    if (typeof window !== "undefined") {
        (function () {
            let rafScheduled = false;

            function clamp(v: number, a = 0, b = 1) {
                return Math.min(b, Math.max(a, v));
            }

            function computeReadingTimeMinutes(articleEl: HTMLElement, readingTimeEl: HTMLElement) {
                let words = 0;
                if (articleEl && articleEl.textContent) {
                    const text = articleEl.textContent.replace(/\s+/g, " ").trim();
                    words = text ? text.split(" ").filter(Boolean).length : 0;
                }
                if (!words && readingTimeEl) {
                    const attr = readingTimeEl.getAttribute("data-reading-time");
                    const n = Number(attr);
                    if (Number.isFinite(n) && n > 0) return Math.max(1, Math.round(n));
                }
                const wordsPerMinute = 200;
                return Math.max(1, Math.round(words / wordsPerMinute));
            }

            function updateReadingTimeImpl() {
                const readingTimeEl = document.getElementById("reading-time-text");
                const articleEl =
                    document.querySelector("main .prose") ||
                    document.querySelector(".prose");
                const article = articleEl instanceof HTMLElement ? articleEl : null;

                if (!article || !readingTimeEl) return;

                const readingTimeValue = computeReadingTimeMinutes(article, readingTimeEl);

                const windowHeight = window.innerHeight;
                const articleTop = article.getBoundingClientRect().top + window.scrollY;
                const totalHeight = Math.max(0, article.scrollHeight - windowHeight);
                const scrolled = clamp(window.scrollY - articleTop, 0, totalHeight);
                const progress = totalHeight === 0 ? 1 : scrolled / totalHeight;

                const minutesLeft = Math.max(
                    1,
                    Math.ceil(readingTimeValue * (1 - progress))
                );
                readingTimeEl.textContent = `${minutesLeft} min left`;
            }

            function scheduleUpdateReadingTime() {
                if (rafScheduled) return;
                rafScheduled = true;
                requestAnimationFrame(() => {
                    rafScheduled = false;
                    updateReadingTimeImpl();
                });
            }

            document.addEventListener("DOMContentLoaded", updateReadingTimeImpl);
            updateReadingTimeImpl();
            window.addEventListener("resize", scheduleUpdateReadingTime);
            window.addEventListener("scroll", scheduleUpdateReadingTime, {passive: true});
        })();

        const toggle = document.getElementById("headings-toggle");
        const listContainer = document.getElementById(
            "headings-list-container",
        );
        const list = document.getElementById("headings-list");

        if (toggle && listContainer && list) {
            const buttonEl = toggle.querySelector(":scope > div:last-child");

            function getHeadings() {
                const art =
                    document.querySelector("main .prose") ||
                    document.querySelector(".prose");
                if (!art) return [];
                return Array.from(art.querySelectorAll("h1, h2, h3"));
            }

            function buildHeadingsMenu() {
                if (list) {
                    list.innerHTML = "";
                }
                const headings = getHeadings();
                headings.forEach((heading, i) => {
                    if (!heading.id) heading.id = "heading-" + i;
                    const li = document.createElement("li");
                    const a = document.createElement("a");
                    a.textContent = heading.textContent || "";
                    a.href = "#" + heading.id;
                    a.className =
                        "block px-2 py-1 rounded hover:bg-zinc-100 dark:hover:bg-zinc-800 transition text-zinc-800 dark:text-zinc-200 font-medium underline" +
                        (heading.tagName === "H1"
                            ? " text-base font-bold underline"
                            : heading.tagName === "H2"
                                ? " text-sm font-semibold pl-4 underline"
                                : " text-sm font-normal pl-8 underline");
                    a.addEventListener("click", (ev) => {
                        ev.preventDefault();
                        const target = document.getElementById(heading.id);
                        if (target)
                            target.scrollIntoView({
                                behavior: "smooth",
                                block: "start",
                            });
                        collapseMenu();
                    });
                    li.appendChild(a);
                    if (list) {
                        list.appendChild(li);
                    }
                });
            }

            function expandMenu() {
                if (listContainer) {
                    listContainer.classList.remove(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    listContainer.classList.add(
                        "opacity-100",
                        "pointer-events-auto",
                    );
                    if (buttonEl)
                        buttonEl.classList.remove(
                            "bg-white/70",
                            "backdrop-blur-xs",
                            "shadow-sm",
                            "dark:bg-zinc-900/70",
                            "dark:backdrop-blur-xs",
                            "dark:shadow-sm",
                        );
                    buildHeadingsMenu();
                }
            }

            function collapseMenu() {
                if (listContainer) {
                    listContainer.classList.add(
                        "opacity-0",
                        "pointer-events-none",
                    );
                    listContainer.classList.remove(
                        "opacity-100",
                        "pointer-events-auto",
                    );
                }
                if (buttonEl)
                    buttonEl.classList.add(
                        "bg-white/70",
                        "backdrop-blur-xs",
                        "shadow-sm",
                        "dark:bg-zinc-900/70",
                        "dark:backdrop-blur-xs",
                        "dark:shadow-sm",
                    );
            }

            let expanded = false;
            toggle.addEventListener("click", (e) => {
                if (listContainer.contains(e.target)) return;
                expanded ? collapseMenu() : expandMenu();
                expanded = !expanded;
            });

            document.addEventListener("click", (e) => {
                if (expanded && !toggle.contains(e.target)) {
                    collapseMenu();
                    expanded = false;
                }
            });

            collapseMenu();
        }

        (function () {
            const navSelector = (id: string): HTMLElement | null => document.getElementById(id);

            function navigateToSlug(slug: any) {
                if (!slug) return;
                window.location.assign(`/cinema/reviews/${slug}`);
            }

            function normalizeDataset(val: string | null) {
                if (val === null) return null;
                val = String(val).trim();
                if (!val || val === "null" || val === "undefined") return null;
                return val;
            }

            function resolveSlugFromGlobal(id: string, datasetSlug: string | null) {
                const ds = normalizeDataset(datasetSlug);
                if (ds) return ds;
                const nav = window.__POST_NAV;
                if (!nav || !Array.isArray(nav.slugs) || !nav.current) return null;
                const idx = nav.slugs.indexOf(nav.current);
                if (idx === -1) return null;
                if (id === "prev-article-btn") return idx > 0 ? nav.slugs[idx - 1] : null;
                if (id === "next-article-btn") return idx < nav.slugs.length - 1 ? nav.slugs[idx + 1] : null;
                return null;
            }

            function wireButton(id: string) {
                const el = navSelector(id);
                if (!el) return;

                const original = el.getAttribute("data-slug");
                const resolved = resolveSlugFromGlobal(id, original);
                const slug = resolved || null;

                if (!slug) {
                    el.setAttribute("aria-disabled", "true");
                    el.setAttribute("tabindex", "-1");
                    el.classList.add("pointer-events-none", "opacity-30");
                    el.removeAttribute("href");
                    el.removeAttribute("data-slug");
                } else {
                    el.setAttribute("data-slug", slug);
                    el.setAttribute("href", `/cinema/reviews/${slug}`);
                    el.setAttribute("aria-disabled", "false");
                    el.removeAttribute("tabindex");
                    el.classList.remove("pointer-events-none", "opacity-30");
                }

                el.addEventListener("click", (ev) => {
                    if (!slug) {
                        ev.preventDefault();
                        return;
                    }
                    ev.preventDefault();
                    navigateToSlug(slug);
                });

                el.addEventListener("keydown", (ev) => {
                    if (!slug) return;
                    if (ev.key === "Enter" || ev.key === " ") {
                        ev.preventDefault();
                        navigateToSlug(slug);
                    }
                });
            }

            document.addEventListener("DOMContentLoaded", () => {
                wireButton("prev-article-btn");
                wireButton("next-article-btn");
            });
            wireButton("prev-article-btn");
            wireButton("next-article-btn");
        })();
    }
</script>
