---
import Layout from "./Layout.astro";
import "../styles/global.css";
import { Icon } from "astro-icon/components";

const { frontmatter } = Astro.props;

const title = frontmatter.title || "Unset";
const description = frontmatter.description || "No description provided";
---

<Layout>
    <div class="flex flex-col items-center justify-center">
        <h1 class="text-4xl font-normal mt-10">{title}</h1>
        <p class="text-xl mt-4 mb-10 max-w-2xl text-center px-4">
            {description}
        </p>
        <hr class="w-128 border-t-2 border-zinc-400 mb-10" />
    </div>
    <div class="flex w-full items-center justify-center">
        <div class="flex flex-col w-screen prose">
            <slot />
        </div>
    </div>
    <div
        class="fixed w-full bottom-8 left-0 flex items-center justify-center gap-5 z-50"
    >
        <div
            class="flex rounded-full bg-white/70 backdrop-blur-xs shadow-sm overflow-hidden h-full"
        >
            <a
                id="blog-back-btn"
                class="flex items-center justify-center p-4 hover:bg-gray-200 transition"
                href="#"
            >
                <Icon name="material-symbols:arrow-back" class="text-2xl" />
            </a>
        </div>

        <!-- Added reading time UI (uses frontmatter.readingTime if present) -->
        <div
            class="flex rounded-full bg-white/70 backdrop-blur-xs shadow-sm overflow-hidden items-center justify-center py-4 px-8"
            id="reading-time-container"
        >
            <Icon name="material-symbols:schedule-outline" class="text-lg dark:text-white" />
            <span
                id="reading-time-text"
                class="ml-2 text-lg font-normal"
                data-reading-time={frontmatter.readingTime}
            >{frontmatter.readingTime ? `${frontmatter.readingTime} min left` : "1 min left"}</span>
        </div>

        <div
            id="headings-toggle"
            class="relative flex items-end transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] w-14 h-14 rounded-full group overflow-visible"
            style="cursor:pointer;"
        >
            <div
                id="headings-list-container"
                class="absolute -left-1 bottom-0 ml-2 px-4 pt-6 pb-12 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] flex flex-col items-start bg-white/70 shadow-sm rounded-3xl w-72 max-h-96 z-10"
            >
                <ul
                    id="headings-list"
                    class="w-full space-y-1 overflow-y-auto scrollbar-thin scrollbar-thumb-zinc-800 scrollbar-track-rounded-full scrollbar-track-zinc-100"
                >
                </ul>
            </div>
            <div
                class="flex items-center justify-center w-14 h-14 z-99 bg-white/70 shadow-sm rounded-full transition"
            >
                <Icon
                    name="material-symbols:text-fields"
                    class="text-2xl dark:text-white"
                />
            </div>
        </div>
    </div>
</Layout>

<script>
    if (typeof window !== "undefined") {
        // simple helper for back button
        const $ = id => document.getElementById(id);
        const backBtn = $("blog-back-btn");
        backBtn?.addEventListener("click", e => { e.preventDefault(); window.history.back(); });

        // Reading time: robust client-side computation (word count + RAF batching)
        (function () {
            let rafScheduled = false;

            function clamp(v, a = 0, b = 1) {
                return Math.min(b, Math.max(a, v));
            }

            function computeReadingTimeMinutes(articleEl, readingTimeEl) {
                let words = 0;
                if (articleEl && articleEl.textContent) {
                    const text = articleEl.textContent.replace(/\s+/g, " ").trim();
                    words = text ? text.split(" ").filter(Boolean).length : 0;
                }
                if (!words && readingTimeEl) {
                    const attr = readingTimeEl.getAttribute("data-reading-time");
                    const n = Number(attr);
                    if (Number.isFinite(n) && n > 0) return Math.max(1, Math.round(n));
                }
                const wordsPerMinute = 200;
                return Math.max(1, Math.round(words / wordsPerMinute));
            }

            function updateReadingTimeImpl() {
                const readingTimeEl = document.getElementById("reading-time-text");
                const articleEl =
                    document.querySelector("main .prose") ||
                    document.querySelector(".prose");
                const article = articleEl instanceof HTMLElement ? articleEl : null;

                if (!article || !readingTimeEl) return;

                const readingTimeValue = computeReadingTimeMinutes(article, readingTimeEl);

                const windowHeight = window.innerHeight;
                const articleTop = article.getBoundingClientRect().top + window.scrollY;
                const totalHeight = Math.max(0, article.scrollHeight - windowHeight);
                const scrolled = clamp(window.scrollY - articleTop, 0, totalHeight);
                const progress = totalHeight === 0 ? 1 : scrolled / totalHeight;

                const minutesLeft = Math.max(1, Math.ceil(readingTimeValue * (1 - progress)));
                readingTimeEl.textContent = `${minutesLeft} min left`;
            }

            function scheduleUpdateReadingTime() {
                if (rafScheduled) return;
                rafScheduled = true;
                requestAnimationFrame(() => {
                    rafScheduled = false;
                    updateReadingTimeImpl();
                });
            }

            document.addEventListener("DOMContentLoaded", updateReadingTimeImpl);
            updateReadingTimeImpl();
            window.addEventListener("resize", scheduleUpdateReadingTime);
            window.addEventListener("scroll", scheduleUpdateReadingTime, { passive: true });
        })();

        // Headings toggle (preserve existing behavior)
        const toggle = document.getElementById("headings-toggle"),
              listContainer = document.getElementById("headings-list-container"),
              list = document.getElementById("headings-list"),
              btnEl = toggle?.querySelector(":scope > div:last-child");

        if (toggle && listContainer && list) {
            const tagStyles = {
                H1: " text-base font-bold underline",
                H2: " text-sm font-semibold pl-4 underline",
                H3: " text-sm font-normal pl-8 underline"
            };

            const toggleClass = (el, add, ...cls) => el && el.classList[add ? "add" : "remove"](...cls);

            const getHeadings = () =>
                Array.from((document.querySelector("main .prose") || document.querySelector(".prose") || {querySelectorAll:()=>[]}).querySelectorAll("h1, h2, h3"));

            const buildHeadingsMenu = () => {
                list.innerHTML = "";
                getHeadings().forEach((heading, i) => {
                    if (!heading.id) heading.id = "heading-" + i;
                    const a = Object.assign(document.createElement("a"), {
                        textContent: heading.textContent || "",
                        href: "#" + heading.id,
                        className: "block px-2 py-1 rounded hover:bg-zinc-100 transition text-zinc-800 font-medium underline" + ((tagStyles)[heading.tagName] || "")
                    });
                    a.onclick = ev => {
                        ev.preventDefault();
                        document.getElementById(heading.id)?.scrollIntoView({behavior:"smooth",block:"start"});
                        collapseMenu();
                    };
                    const li = document.createElement("li");
                    li.appendChild(a);
                    list.appendChild(li);
                });
            };

            const expandMenu = () => {
                toggleClass(listContainer, false, "opacity-0", "pointer-events-none");
                toggleClass(listContainer, true, "opacity-100", "pointer-events-auto");
                toggleClass(btnEl, false, "bg-white/70", "shadow-sm");
                buildHeadingsMenu();
            };

            const collapseMenu = () => {
                toggleClass(listContainer, true, "opacity-0", "pointer-events-none");
                toggleClass(listContainer, false, "opacity-100", "pointer-events-auto");
                toggleClass(btnEl, true, "bg-white/70", "shadow-sm");
            };

            let expanded = false;
            toggle.addEventListener("click", e => {
                if (e.target instanceof Node && listContainer.contains(e.target)) return;
                expanded ? collapseMenu() : expandMenu();
                expanded = !expanded;
            });

            document.addEventListener("click", e => {
                if (expanded && !(e.target instanceof Node && toggle.contains(e.target))) {
                    collapseMenu();
                    expanded = false;
                }
            });

            collapseMenu();
        }
    }
</script>
