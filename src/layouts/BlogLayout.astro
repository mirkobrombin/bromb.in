---
import Layout from "./Layout.astro";
import "../styles/global.css";
import { Icon } from "astro-icon/components";

const { frontmatter } = Astro.props;

const title = frontmatter.title || "Unset";
const description = frontmatter.description || "No description provided";
---

<Layout>
    <div class="flex flex-col items-center justify-center">
        <h1 class="text-4xl lg:text-5xl font-normal mt-10 dark:text-white">{title}</h1>
        <p class="text-xl lg:text-2xl mt-4 mb-10 max-w-2xl text-center px-4 dark:text-zinc-300">
            {description}
        </p>
        <hr class="w-full border-t-2 border-zinc-400 dark:border-zinc-600 mb-10" />
    </div>
        <div class="flex flex-col prose dark:prose-invert min-w-full lg:prose-md lg:prose-p:text-xl">
            <slot />
        </div>
    <div
            class="sticky w-full bottom-2 sm:bottom-8 left-0 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-5 z-50 px-2"
    >
        <div
                class="flex rounded-full bg-white/70 dark:bg-zinc-800/80 backdrop-blur-xs shadow-sm overflow-hidden h-full"
        >
            <a
                    id="blog-back-btn"
                    class="flex items-center justify-center p-3 sm:p-4 hover:bg-gray-200 dark:hover:bg-zinc-800 transition"
                    href="#"
            >
                <Icon name="material-symbols:arrow-back" class="text-2xl dark:text-white" />
            </a>
        </div>

        <div
                class="flex rounded-full bg-white/70 dark:bg-zinc-800/80 backdrop-blur-xs shadow-sm overflow-hidden items-center justify-center py-3 sm:py-4 px-5 sm:px-8"
                id="reading-time-container"
        >
            <Icon name="material-symbols:schedule-outline" class="text-lg dark:text-white" />
            <span
                    id="reading-time-text"
                    class="ml-2 text-lg font-normal dark:text-white"
                    data-reading-time={frontmatter.readingTime}
            >{frontmatter.readingTime ? `${frontmatter.readingTime} min left` : "1 min left"}</span>
        </div>

        <div
                id="headings-toggle"
                class="relative flex items-end transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] w-12 h-12 sm:w-14 sm:h-14 rounded-full group overflow-visible"
                style="cursor:pointer;"
        >
            <div
                    id="headings-list-container"
                    class="absolute -left-1 bottom-0 ml-2 px-2 sm:px-4 pt-6 pb-12 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] flex flex-col items-start bg-white/70 dark:bg-zinc-800/80 shadow-sm rounded-3xl w-64 sm:w-72 max-h-80 sm:max-h-96 z-10 backdrop-blur-xs"
            >
                <ul
                        id="headings-list"
                        class="w-full space-y-1 overflow-y-auto scrollbar-thin scrollbar-thumb-zinc-800 dark:scrollbar-thumb-zinc-600 scrollbar-track-rounded-full scrollbar-track-zinc-100 dark:scrollbar-track-zinc-800"
                >
                </ul>
            </div>
            <div
                    class="flex items-center justify-center w-12 h-12 sm:w-14 sm:h-14 z-99 bg-white/70 dark:bg-zinc-800/80 shadow-sm rounded-full transition backdrop-blur-xs"
            >
                <Icon
                        name="material-symbols:text-fields"
                        class="text-2xl dark:text-white"
                />
            </div>
        </div>
    </div>
</Layout>

<script>
    import '../../scripts/article-ui.ts';
    import { initBlogBackButton } from '../../scripts/blog-back.ts';

    initBlogBackButton();
</script>
