---
import Layout from "./Layout.astro";
import { Icon } from "astro-icon/components";
import "../styles/global.css";

interface ArticleFrontmatter {
    title?: string;
    author?: string;
    date?: string;
    description?: string;
    cover?: string;
    prev?: string;
    next?: string;
}

interface ArticleLayoutProps {
    frontmatter: ArticleFrontmatter;
    prevSlug?: string;
    nextSlug?: string;
    readingTime?: number;
}

const { frontmatter, prevSlug, nextSlug, readingTime } = Astro.props as ArticleLayoutProps;

const title = frontmatter.title || "Unset";
const author = frontmatter.author || "Mirko & Laura";
const rawDate = frontmatter.date ?? null;
const description = frontmatter.description || "No description available.";
const cover = frontmatter.cover || "https://placehold.co/300x450/png";

const locale = (Astro.currentLocale || "en");
function formatDate(iso?: string | null) {
    if (!iso) return "";
    try {
        const d = new Date(iso);
        return d.toLocaleDateString(locale, {
            year: "numeric",
            month: "long",
            day: "numeric",
        });
    } catch {
        return String(iso);
    }
}
const date = formatDate(rawDate);

const articleFiles = import.meta.glob("../pages/stories/articles/*.md");
const articleEntries = Object.entries(articleFiles);
const articlePosts = await Promise.all(
  articleEntries.map(async ([path, loader]) => {
    const mod = await loader();
    const file = path.split("/").pop() || "";
    const slugFromFile = file.replace(".md", "");
    const titleFromFile = String(mod?.frontmatter?.title ?? slugFromFile).trim();
    return { slug: slugFromFile, title: titleFromFile };
  })
);
const titleToSlug = new Map(articlePosts.map(p => [p.title.toLowerCase(), p.slug]));
function resolveManualRef(value: any) {
  if (!value) return null;
  const s = String(value).trim();
  if (!s) return null;
  const byTitle = titleToSlug.get(s.toLowerCase());
  if (byTitle) return byTitle;
  if (articlePosts.find(p => p.slug === s)) return s;
  return null;
}
const fmPrevResolved = resolveManualRef(frontmatter?.prev);
const fmNextResolved = resolveManualRef(frontmatter?.next);
const effectivePrevSlug = prevSlug ?? fmPrevResolved ?? null;
const effectiveNextSlug = nextSlug ?? fmNextResolved ?? null;
---

<Layout>
  <div class="overflow-x-hidden">
    <div
        class="flex flex-col md:flex-row gap-6 items-start md:items-end justify-between mb-8 mt-5 lg:px-20 lg:py-12 w-full text-white rounded-lg bg-cover bg-center bg-no-repeat overflow-hidden"
        style={`background-image: url('${cover}'); min-height: 18rem;`}
    >
        <div class="w-full md:max-w-2/5 px-4 md:px-0 py-6 md:py-0">
            <h1 class="text-3xl md:text-5xl font-normal leading-tight">{title}</h1>
            <p class="mt-2 text-sm md:text-4xl flex flex-col md:flex-row md:items-center gap-2 text-zinc-100">
                <span class="text-base md:text-xl">by {author}</span>
                <span class="text-xs md:text-xl text-zinc-200">- {date}</span>
            </p>
            <p class="mt-3 text-sm md:text-lg max-w-lg text-zinc-100">
                {description}
            </p>
        </div>

        <div class="flex flex-row gap-2 items-center justify-center w-max px-4 md:px-0 py-3">
            <a
                class="flex items-center justify-center rounded-full bg-white text-black p-2 dark:bg-zinc-900 dark:text-white"
                aria-label="Share"
            >
                <Icon name="material-symbols:share" class="text-base" />
            </a>
        </div>
    </div>

    <div class="flex w-full items-center justify-center pb-12">
        <div class="flex flex-col prose dark:prose-invert w-full max-w-full lg:prose-md lg:prose-p:text-xl">
            <slot />
        </div>
    </div>

    <div
        class="sticky w-full bottom-4 left-0 flex flex-wrap items-center justify-center gap-3 px-4 md:gap-5 md:px-0"
    >
        <div
            class="flex rounded-full bg-white/70 backdrop-blur-xs shadow-sm overflow-hidden h-full dark:bg-zinc-800/80 dark:shadow-zinc-900/30"
        >
            <a
                id="prev-article-btn"
                data-slug={effectivePrevSlug}
                class={`flex items-center justify-center py-3 px-4 md:py-4 md:px-6 hover:bg-gray-200 transition border-r border-r-zinc-200 dark:hover:bg-zinc-800 dark:border-zinc-800 ${!effectivePrevSlug ? "pointer-events-none opacity-30" : ""}`}
                href={effectivePrevSlug ? `/stories/articles/${effectivePrevSlug}` : undefined}
                aria-disabled={!effectivePrevSlug}
                tabindex={!effectivePrevSlug ? -1 : undefined}
            >
                <Icon name="material-symbols:arrow-back" class="text-2xl" />
            </a>
            <a
                id="next-article-btn"
                data-slug={effectiveNextSlug}
                class={`flex items-center justify-center py-3 px-4 md:py-4 md:px-6 hover:bg-gray-200 transition dark:hover:bg-zinc-800 ${!effectiveNextSlug ? "pointer-events-none opacity-30" : ""}`}
                href={effectiveNextSlug ? `/stories/articles/${effectiveNextSlug}` : undefined}
                aria-disabled={!effectiveNextSlug}
                tabindex={!effectiveNextSlug ? -1 : undefined}
            >
                <Icon name="material-symbols:arrow-forward" class="text-2xl" />
            </a>
        </div>

        <div
            class="flex rounded-full bg-white/70 backdrop-blur-xs shadow-sm overflow-hidden items-center justify-center py-2 px-4 md:py-4 md:px-8 dark:bg-zinc-800/80 dark:shadow-zinc-900/30"
            id="reading-time-container"
        >
            <Icon name="material-symbols:schedule-outline" class="text-lg" />
            <span class="ml-2 text-sm md:text-lg font-normal" id="reading-time-text"
                data-reading-time={readingTime}
                >{readingTime} min left</span
            >
        </div>

        <div
            id="headings-toggle"
            class="relative flex items-end transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] w-14 h-14 rounded-full group overflow-visible"
            style="cursor:pointer;"
        >
            <div
                id="headings-list-container"
                class="absolute left-1/2 -translate-x-1/2 bottom-0 px-4 pt-6 pb-12 opacity-0 pointer-events-none transition-all duration-300 ease-[cubic-bezier(.4,2,.6,1)] flex flex-col items-start bg-white/70 shadow-sm rounded-3xl w-72 max-h-96 z-10 dark:bg-zinc-900/90 dark:shadow-zinc-900/30 backdrop-blur-xs"
            >
                <ul
                    id="headings-list"
                    class="w-full space-y-1 overflow-y-auto scrollbar-thin scrollbar-thumb-zinc-800 scrollbar-track-rounded-full scrollbar-track-zinc-100 dark:scrollbar-thumb-zinc-200 dark:scrollbar-track-zinc-900"
                >
                </ul>
            </div>
            <div
                class="flex items-center justify-center w-14 h-14 z-99 bg-white/70 shadow-sm rounded-full transition dark:bg-zinc-800/80 dark:shadow-zinc-900/30 backdrop-blur-xs"
            >
                <Icon name="material-symbols:text-fields" class="text-2xl" />
            </div>
        </div>
    </div>
  </div>
</Layout>

<script>
    import '../../scripts/article-ui.ts';
</script>
