---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import "../styles/global.css";

interface Props {
  stories: any[];
}

const { stories = [] } = Astro.props;
const currentLang = Astro.currentLocale || 'en';
const t = useTranslations(currentLang as any);
---
<main>
  <div class="flex flex-col items-center justify-center px-4">
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-normal mt-10 dark:text-white transition-colors duration-200">{t('nav.stories')}</h1>
    <p class="text-base md:text-xl lg:text-2xl mt-4 mb-10 max-w-2xl text-center px-4 text-zinc-700 dark:text-zinc-300 transition-colors duration-200">
      Read some of our latest stories and articles about various topics that interest us.
    </p>
    <hr class="w-full border-t-2 border-zinc-400 dark:border-zinc-700 mb-10" />
  </div>

  <div class="flex w-full items-center justify-center px-4">
    <div class="flex flex-col max-w-3xl w-full">
      <div class="flex flex-col gap-12 items-center max-w-4xl w-full">
        {
          stories.map((story, i) => (
            <div class={`flex flex-col md:flex-row ${i % 2 !== 0 ? 'md:flex-row-reverse' : ''} items-start md:items-center gap-6 w-full border-b border-zinc-200 dark:border-zinc-700 pb-6`}>
              <img
                src={story.cover}
                alt={story.title}
                loading="lazy"
                class="w-full lg:max-w-1/2 md:flex-1 h-56 md:h-auto object-cover rounded-md shadow-md dark:shadow-lg"
              />

              <div class="flex-1 flex flex-col gap-3">
                <h2 class="text-2xl md:text-5xl font-medium text-zinc-900 dark:text-zinc-100 transition-colors duration-200">
                  <a href={getRelativeLocaleUrl(currentLang, `stories/articles/${story.slug}`)} class="inline-block">{story.title}</a>
                </h2>
                <p class="text-sm md:text-2xl text-zinc-600 dark:text-zinc-400 transition-colors duration-200">
                  by {story.author} –{" "}
                  <span class="text-xs md:text-base text-zinc-500 dark:text-zinc-300">
                    {formatDate(story.date)}
                  </span>
                </p>
                <p class="text-sm md:text-base text-zinc-800 dark:text-zinc-300 transition-colors duration-200">
                  {story.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</main>

