---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations } from '../i18n/utils';
import "../styles/global.css";

interface Props {
  stories: any[];
}

const { stories = [] } = Astro.props;
const currentLang = Astro.currentLocale || 'en';
const t = useTranslations(currentLang as any);
---
<main>
  <div class="flex flex-col items-center justify-center">
    <h1 class="text-4xl lg:text-5xl font-normal mt-10 dark:text-white transition-colors duration-200">{t('nav.stories')}</h1>
    <p class="text-xl lg:text-2xl mt-4 mb-10 max-w-2xl text-center px-4 text-zinc-700 dark:text-zinc-300 transition-colors duration-200">
      Read some of our latest stories and articles about various topics that interest us.
    </p>
    <hr class="w-full border-t-2 border-zinc-400 dark:border-zinc-700 mb-10" />
  </div>

  <div class="flex w-full items-center justify-center">
    <div class="flex flex-col max-w-3xl">
      <div class="flex flex-col gap-24 items-center max-w-4xl">
        {
          stories.map((story, i) => (
            <div class="flex flex-row items-center justify-between gap-12 w-full max-md:flex-col">
              {i % 2 === 0 ? (
                <>
                  <div class="flex-1 flex gap-2 flex-col justify-center">
                    <h2 class="text-5xl font-medium text-zinc-900 dark:text-zinc-100 transition-colors duration-200">
                      <a href={getRelativeLocaleUrl(currentLang, `stories/articles/${story.slug}`)}>{story.title}</a>
                    </h2>
                    <p class="text-2xl text-zinc-600 dark:text-zinc-400 transition-colors duration-200">
                      by {story.author} –{" "}
                      <span class="text-base text-zinc-500 dark:text-zinc-300">
                        {story.date}
                      </span>
                    </p>
                    <p class="text-base text-zinc-800 dark:text-zinc-300 transition-colors duration-200">
                      {story.description}
                    </p>
                  </div>
                  <img
                    src={story.cover}
                    alt={story.title}
                    class="size-72 object-cover rounded-md flex-1"
                  />
                </>
              ) : (
                <>
                  <img
                    src={story.cover}
                    alt={story.title}
                    class="size-72 object-cover rounded-md shadow-md dark:shadow-lg flex-1"
                  />
                  <div class="flex-1 flex gap-2 flex-col justify-center">
                    <h2 class="text-5xl font-medium text-zinc-900 dark:text-zinc-100 transition-colors duration-200">
                      <a href={getRelativeLocaleUrl(currentLang, `stories/articles/${story.slug}`)}>{story.title}</a>
                    </h2>
                    <p class="text-2xl text-zinc-600 dark:text-zinc-400 transition-colors duration-200">
                      by {story.author} –{" "}
                      <span class="text-base text-zinc-500 dark:text-zinc-300">
                        {story.date}
                      </span>
                    </p>
                    <p class="text-base text-zinc-800 dark:text-zinc-300 transition-colors duration-200">
                      {story.description}
                    </p>
                  </div>
                </>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</main>

