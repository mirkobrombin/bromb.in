---
import {Icon} from "astro-icon/components";
import {useTranslations} from '../i18n/utils';

interface Props {
    title: string;
    subtitle: string;
    movies: any[];
}

const {movies, title} = Astro.props;

const currentLang = Astro.currentLocale || 'en';
const t = useTranslations(currentLang as any);

const totalPopcorns = 5;
const movieMetaFields = [
    {key: "movieRelease", label: ""},
    {key: "movieCategory", label: ""},
    {key: "movieLength", label: ""},
];

function formatDate(iso?: string) {
    if (!iso) return '';
    try {
        const d = new Date(iso);
        return d.toLocaleDateString(currentLang, {year: 'numeric', month: 'long', day: 'numeric'});
    } catch {
        return iso;
    }
}
---
<div class="overflow-x-hidden">
    <div class="flex flex-col items-center justify-center px-4">
        <h1 class="text-3xl md:text-4xl font-normal mt-10 text-center">{t('cinema.title')}</h1>
        <p class="text-base md:text-2xl mt-4 mb-6 max-w-2xl text-center px-2">
            {t('cinema.subtitle')}
        </p>
        <hr class="w-full max-w-xs border-t-2 border-zinc-400 mb-6"/>
    </div>

    <div class="flex w-full items-center justify-center px-4">
        <div class="flex flex-col max-w-3xl w-full">
            <div class="flex flex-col gap-12">
                {
                    movies.map((movie) => (
                            <div class="flex flex-col md:flex-row gap-6 md:gap-8 items-start md:items-center w-full border-b border-zinc-200 dark:border-zinc-700 pb-6">
                                <div class="w-full md:w-1/2 rounded-sm overflow-hidden shadow-lg flex-shrink-0">
                                    <a href={`./reviews/${movie.slug}`} class="block w-full h-full">
                                        <img
                                                src={movie.movieCover}
                                                alt={movie.title}
                                                loading="lazy"
                                                class="w-full h-56 md:h-auto object-cover transform hover:scale-105 transition-transform duration-300"
                                        />
                                    </a>
                                </div>

                                <div class="flex flex-col gap-3 w-full">
                                    <h2 class="text-2xl md:text-4xl font-normal leading-tight text-zinc-900 dark:text-zinc-100">
                                        <a href={`./reviews/${movie.slug}`} class="inline-block">
                                            {movie.title}
                                        </a>
                                    </h2>
                                    <p class="text-sm md:text-base text-zinc-600 dark:text-zinc-400">
                                        {t('cinema.by')} {movie.author} · <span
                                            class="text-xs md:text-sm text-zinc-500">{formatDate(movie.date)}</span>
                                    </p>

                                    <p class="text-xs md:text-sm text-zinc-500 flex flex-wrap gap-2">
                                        {movieMetaFields.map(({key}, idx) => (
                                                <>
                                                    <span>{movie[key]}</span>
                                                    {idx < movieMetaFields.length - 1 &&
                                                            <span class="text-zinc-300">•</span>}
                                                </>
                                        ))}
                                    </p>

                                    <p class="text-sm text-zinc-700 dark:text-zinc-300 max-w-prose">
                                        {movie.excerpt}
                                    </p>

                                    <div class="flex items-center gap-3 mt-2">
                                        <div class="flex items-center gap-2 bg-red-50 dark:bg-red-900/30 px-3 py-1 rounded-full text-sm">
                                            {Array.from({length: totalPopcorns}).map((_, i) => (
                                                    <span class={`text-base ${i < movie.popcornScore ? "opacity-100" : "opacity-20"}`}>🍿</span>
                                            ))}
                                            <span class="text-red-600 dark:text-red-400 font-medium text-sm ml-1">
                                            {movie.popcornScore}/{totalPopcorns}
                                        </span>
                                        </div>

                                        <a class="flex items-center justify-center rounded-full bg-black text-white p-2 text-sm"
                                           aria-label="share">
                                            <Icon name="material-symbols:share" class="text-base"/>
                                        </a>
                                    </div>
                                </div>
                            </div>
                    ))
                }
            </div>
        </div>
    </div>
</div>
