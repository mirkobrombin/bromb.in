---
import Layout from "../../layouts/Layout.astro";
import CinemaListView from "../../views/CinemaList.astro";
import { useTranslations } from '../../i18n/utils';
import { loadCinemaFromGlob } from "../../lib/resolveGlob.ts";

const currentLang = Astro.currentLocale || 'en';
const t = useTranslations(currentLang);

const reviewFiles = import.meta.glob("./reviews/*.md");
const movies = await loadCinemaFromGlob(reviewFiles);
---

<Layout>
    <CinemaListView
            movies={movies}
            title={t('cinema.title')}
            subtitle={t('cinema.subtitle')}
    />
</Layout>