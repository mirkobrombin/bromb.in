---
import Layout from "../../../layouts/Layout.astro";
import "../../../styles/global.css";
import StoriesList from "../../../views/StoriesList.astro";
import { loadArticlesFromGlob } from "../../../lib/resolveGlob.ts";

const storyFiles = import.meta.glob('./articles/*.md');
const stories = await loadArticlesFromGlob(storyFiles);
---
<Layout>
    <StoriesList stories={stories} />
</Layout>
