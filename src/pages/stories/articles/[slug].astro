---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { createSlugStaticPaths, loadSlugContent } from "../../../lib/resolveGlob.ts";

export async function getStaticPaths() {
  const storyFiles = import.meta.glob('./*.md');
  return createSlugStaticPaths(storyFiles);
}

const storyFiles = import.meta.glob('./*.md');
const { slug } = Astro.params;
const { Content, frontmatter, prevSlug, nextSlug } = await loadSlugContent(storyFiles, slug ?? '');

// Get all slugs for navigation
const slugs = Object.keys(storyFiles)
  .map(path => path.split('/').pop()?.replace('.md', '') ?? '')
  .filter(Boolean)
  .sort();
---

<ArticleLayout frontmatter={frontmatter} prevSlug={prevSlug} nextSlug={nextSlug}>
  <Content />
</ArticleLayout>

<script type="module">
  import hydratePostNav from '../../../../scripts/hydrate-post-nav.ts';
  
  const postNavPayload = JSON.stringify({ 
    slugs: JSON.parse(document.currentScript?.dataset.slugs || '[]'), 
    current: document.currentScript?.dataset.current || null 
  });
  
  hydratePostNav(postNavPayload);
</script>

<script type="application/json" data-slugs={JSON.stringify(slugs)} data-current={slug}></script>

