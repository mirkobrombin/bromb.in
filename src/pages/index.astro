---
import Layout from "../layouts/Layout.astro";
---

<Layout>
    <div
        class="flex flex-col justify-end px-16 pb-10 absolute w-full top-0 right-0 z-[-10] bg-[url(/cover.png)] bg-cover bg-bottom bg-no-repeat h-[80vh]"
    >
        <p class="text-xl lg:text-2xl font-sans text-white max-w-96">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Duis id
            ipsum finibus, ornare tellus id, luctus nisi. Duis diam lacus,
            mattis eget ipsum ac, tristique bibendum enim.
        </p>
        <a
            href="#"
            class="flex items-center justify-center gap-2 text-black bg-white text-2xl font-sans w-max py-2 px-8 rounded-full mt-4 hover:bg-gray-200 transition-colors duration-300"
            >Read more <span class="material-symbols-outlined">
            arrow_outward
            </span></a
        >
    </div>
    <div class="block w-full h-[1500px]"></div>
</Layout>
